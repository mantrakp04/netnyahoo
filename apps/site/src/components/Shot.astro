---
// Real captures of the app. Window shots are the window only (rounded corners, transparent outside),
// so the shadow here follows the window's shape. Several shots fan out, back to front.
// A `panel` is one view rendered by the app without its window frame; it gets a plain rounded card.
// A `loop` plays the part of a shot that moves (scripts/loops.ts): a clip of that rectangle, cut from the
// same capture, laid exactly over the still, so without it (reduced motion, Save-Data) the still is the shot.
import type { ImageMetadata } from "astro";
import { Picture, getImage } from "astro:assets";

export interface Focus {
  /** Where to look, 0–1 across and down the part of the shot that doesn't fit the phone frame. */
  x: number;
  y: number;
  /** How far to zoom in on a phone: the shot is drawn this many times the frame's width. */
  zoom: number;
  /** The phone frame's height / width. */
  ratio?: number;
}
export interface Loop {
  mp4: string;
  webm: string;
  /** The clip's first frame: the still's pixels under it. */
  poster: ImageMetadata;
  /** Where the clip sits on the shot, in the shot's pixels. */
  rect: { x: number; y: number; w: number; h: number };
}
interface Props {
  src: ImageMetadata | ImageMetadata[];
  alt: string;
  sizes: string;
  panel?: boolean;
  eager?: boolean;
  /** On phones, show this part of the shot, bigger, instead of the whole window shrunk to fit. */
  focus?: Focus;
  /** One shot only. */
  loop?: Loop;
}
const { src, alt, sizes: baseSizes, panel = false, eager = false, focus, loop } = Astro.props;
const shots = Array.isArray(src) ? src : [src];
const first = shots[0];
const fan = shots.length > 1;
// Phone crop: the shot is `zoom` frames wide, shifted so the focus point's share of the overflow is hidden.
const ratio = focus?.ratio ?? 0.78;
const aspect = first.height / first.width;
const crop = focus && {
  "--zoom": focus.zoom,
  "--ratio": ratio,
  "--tx": `${(-focus.x * (1 - 1 / focus.zoom) * 100).toFixed(2)}%`,
  "--ty": `${(-focus.y * Math.max(0, 1 - ratio / (focus.zoom * aspect)) * 100).toFixed(2)}%`,
};
const sizes = focus ? `(max-width: 640px) ${Math.round(focus.zoom * 100)}vw, ${baseSizes}` : baseSizes;
// Full-size copies for the lightbox (scripts/lightbox.ts): a click or tap opens the whole window, big.
const full = await Promise.all(shots.map((s) => getImage({ src: s, format: "webp", width: Math.min(s.width, 2880) })));
const name = first.src.split("/").pop()?.split(".")[0]?.split("_")[0] ?? "shot";
const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(3)}%`;
const loopBox =
  loop && !fan
    ? `left: ${pct(loop.rect.x, first.width)}; top: ${pct(loop.rect.y, first.height)}; width: ${pct(loop.rect.w, first.width)}; height: ${pct(loop.rect.h, first.height)}`
    : undefined;
const widths = (s: ImageMetadata) => [640, 960, 1280, 1600, 2200, s.width].filter((w, i, a) => w <= s.width && a.indexOf(w) === i);
---

<div class:list={["crop", { on: !!focus }]} style={crop ? Object.entries(crop).map(([k, v]) => `${k}: ${v}`).join("; ") : undefined}>
<div
  class:list={["shot", { panel, fan }]}
  style={`--n: ${shots.length}; aspect-ratio: ${first.width} / ${first.height}`}
  role={fan ? "img" : undefined}
  aria-label={fan ? alt : undefined}
>
  {
    shots.map((s, i) => (
      <Picture
        src={s}
        alt={fan ? "" : alt}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={widths(s)}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        style={`--i: ${i}`}
      />
    ))
  }
  {
    loop && loopBox && (
      <video class="loop" style={loopBox} data-poster={loop.poster.src} muted playsinline loop preload="none" disablepictureinpicture aria-hidden="true" data-loop>
        <source data-src={loop.webm} type="video/webm" />
        <source data-src={loop.mp4} type="video/mp4" />
      </video>
    )
  }
  <button
    class="zoom-hit"
    type="button"
    aria-label="Enlarge screenshot"
    data-lightbox={JSON.stringify(full.map((f, i) => ({ src: f.src, w: shots[i].width, h: shots[i].height })))}
    data-lightbox-alt={alt}
    data-track="screenshot_opened"
    data-track-shot={name}
  ></button>
</div>
</div>

<script>
  import "../scripts/loops";
</script>

<style>
  .loop {
    position: absolute;
    z-index: 1;
    display: block;
    object-fit: cover;
    pointer-events: none;
  }
  /* Phones: a window shrunk to 343px is unreadable, so show the focus region at a legible size. */
  @media (max-width: 640px) {
    .crop.on {
      position: relative;
      overflow: hidden;
      aspect-ratio: 1 / var(--ratio);
      border-radius: 10px;
      background: var(--paper-deep);
      box-shadow:
        0 0 0 1px rgb(22 19 15 / 0.1),
        0 14px 30px -12px rgb(22 19 15 / 0.35);
    }
    .crop.on > .shot {
      position: absolute;
      top: 0;
      left: 0;
      width: calc(var(--zoom) * 100%);
      transform: translate(var(--tx), var(--ty));
      filter: none;
    }
  }
  .zoom-hit {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .zoom-hit:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  .shot {
    position: relative;
    width: 100%;
    filter: drop-shadow(0 1px 1px rgb(22 19 15 / 0.14)) drop-shadow(0 22px 44px rgb(22 19 15 / 0.2));
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .panel :global(img) {
    border-radius: 12px;
  }
  /* Fanned windows: each one down and to the right of the last, the front one full size. */
  .fan {
    --step: 10%;
  }
  .fan :global(picture) {
    position: absolute;
    inset: 0;
  }
  .fan :global(img) {
    position: absolute;
    top: calc(var(--i) * var(--step) * 0.62);
    left: calc(var(--i) * var(--step));
    width: calc(100% - (var(--n) - 1) * var(--step));
    height: auto;
  }
</style>
