 void BrowserView::RequestFullscreen(bool fullscreen, int64_t display_id) {
+  if (HostsTabsNatively(browser_.get())) {
+    SetProperty(kNativeHostedFullscreenKey, fullscreen);
+    // What the widget would report once its (skipped) transition completed.
+    if (base::FeatureList::IsEnabled(features::kAsyncFullscreenWindowState)) {
+      FullscreenStateChanging();
+    }
+    FullscreenStateChanged();
+    return;
+  }
+
 #if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN) || BUILDFLAG(IS_CHROMEOS)
   // Request target display fullscreen from lower layers on supported platforms.
   browser_widget_->SetFullscreen(fullscreen, display_id);
