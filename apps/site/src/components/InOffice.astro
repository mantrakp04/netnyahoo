---
import Shot from "./Shot.astro";
import DownloadButton from "./DownloadButton.astro";
import office from "../assets/shots/office.webp";
---

<section class="office" aria-label="The app" data-shot="office">
  <div class="wrap">
    <figure class="office-figure">
      <div class="tilt">
        <Shot
          src={office}
          alt="The Netnyahoo window in light mode: three pinned tiles and six tabs in the sidebar, Wikipedia’s article on Chromium open on the right."
          sizes="(max-width: 1440px) 94vw, 1360px"
          focus={{ x: 0, y: 0, zoom: 1.9, ratio: 0.8 }}
        />
      </div>
      <figcaption class="label">
        <span>Fig. 2 — In office</span>
        <span>A screenshot, not a mockup.</span>
      </figcaption>
    </figure>
    {/* Experiment "download-band" (docs/growth.md): shown only to Macs in the "band" variant. */}
    <aside class="band" aria-label="Download" data-download-band hidden>
      <p class="band-line poster">That was a screenshot. <span>This is the app.</span></p>
      <DownloadButton location="office-band" />
    </aside>
  </div>
</section>

<script>
  // The download-band experiment. Only Mac desktops ask for the flag, so only they count as exposures
  // (getFeatureFlag records $feature_flag_called and $experiment_exposure, once per visitor). The variant is
  // bucketed on the visitor id with PostHog's algorithm (scripts/telemetry/flags.ts), so visitors keep theirs.
  // A silent build (not netnyahoo.com, no opt-in) or no Web Crypto: control, no band.
  // On localhost, ?nnflag=band (or control) forces a variant.
  import { getFeatureFlag } from "../scripts/telemetry";

  const FLAG = "download-band";
  const band = document.querySelector<HTMLElement>("[data-download-band]");
  const show = (variant: unknown) => {
    if (band) band.hidden = variant !== "band";
  };

  if (band && document.documentElement.dataset.device === "mac") {
    const local = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
    const forced = local ? new URLSearchParams(location.search).get("nnflag") : null;
    if (forced) show(forced);
    else void getFeatureFlag(FLAG).then(show);
  }
</script>

<style>
  .office {
    padding-top: clamp(24px, 4vw, 64px);
  }
  .office-figure {
    margin: 0;
    perspective: 1600px;
  }
  .tilt {
    transform-origin: 50% 0%;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tilt {
        animation: settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }
  @keyframes settle {
    from {
      transform: rotateX(14deg) scale(0.9) translateY(40px);
      opacity: 0.4;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  .band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin-top: clamp(40px, 5vw, 72px);
    padding: 22px 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule-strong);
  }
  .band[hidden] {
    display: none;
  }
  .band-line {
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.6rem);
    line-height: 0.9;
  }
  .band-line span {
    color: var(--tie);
  }
  @media (prefers-reduced-motion: no-preference) {
    .band {
      animation: band-in 600ms var(--ease-out) both;
    }
  }
  @keyframes band-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (max-width: 640px) {
    .band {
      flex-direction: column;
      align-items: stretch;
    }
    .band :global(.btn) {
      justify-content: center;
    }
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 8px 24px;
    flex-wrap: wrap;
    margin-top: 22px;
    padding-top: 10px;
    border-top: 1px solid var(--rule-strong);
    color: var(--ink-2);
  }
</style>
