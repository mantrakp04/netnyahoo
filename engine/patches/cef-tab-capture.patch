+CefString CefGetMediaCaptureSourceId(CefRefPtr<CefBrowser> browser) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return CefString();
+  }
+  auto browser_impl = CefBrowserHostBase::FromBrowser(browser);
+  content::WebContents* web_contents =
+      browser_impl ? browser_impl->GetWebContents() : nullptr;
+  content::RenderFrameHost* frame =
+      web_contents ? web_contents->GetPrimaryMainFrame() : nullptr;
+  if (!frame || !frame->IsRenderFrameLive()) {
+    return CefString();
+  }
+  return content::WebContentsMediaCaptureId(frame->GetProcess()->GetDeprecatedID(),
+                                            frame->GetRoutingID())
+      .ToString();
+}
