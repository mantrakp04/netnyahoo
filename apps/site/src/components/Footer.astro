---
import { RELEASES, REPO } from "../data/release";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="foot" data-shot="footer">
  <div class="wrap">
    <p class="poster paid" aria-label="Paid for by nobody.">Paid for by nobody.</p>
    <div class="cols">
      <nav class="col" aria-label="Project">
        <p class="label h">Project</p>
        <a class="link" href={REPO} rel="noopener" data-track="github_clicked" data-track-link="source" data-track-location="footer"
          >Source on GitHub</a
        >
        <a class="link" href={`${base}/release-notes`}>Release notes</a>
        <a
          class="link"
          href={RELEASES}
          rel="noopener"
          data-track="github_clicked"
          data-track-link="releases"
          data-track-location="footer">Downloads</a
        >
        <a
          class="link"
          href={`${REPO}/issues`}
          rel="noopener"
          data-track="github_clicked"
          data-track-link="issues"
          data-track-location="footer">Report a bug</a
        >
        {/* Shown once PostHog's support widget is switched on (scripts/analytics.ts). */}
        <button class="link" type="button" data-support="footer" hidden>Write to the office</button>
      </nav>
      <div class="col">
        <p class="label h">Disclaimer</p>
        <p>
          Political satire of Benjamin Netanyahu and his government. Not affiliated with Google, The Browser Company,
          or any government, lobby or donor.
        </p>
        <p>
          This website counts its visitors with PostHog: page views, clicks and session replays, with typing
          masked.
        </p>
      </div>
      <div class="col">
        <p class="label h">Built on</p>
        <p>Chromium, CEF, ungoogled-chromium and uBlock Origin Lite. Open source under Apache 2.0.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--night);
    color: var(--night-ink);
    padding: clamp(64px, 9vw, 128px) 0 clamp(40px, 5vw, 64px);
    margin-top: clamp(64px, 8vw, 120px);
  }
  .paid {
    font-size: clamp(3rem, 0.6rem + 10.4vw, 11.4rem);
    line-height: 0.84;
    margin-left: -0.04em;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 36px;
    margin-top: clamp(48px, 6vw, 88px);
    padding-top: 24px;
    border-top: 1px solid var(--night-rule);
    font-size: var(--t-small);
    color: var(--night-ink-2);
  }
  .col {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .col p:not(.h) {
    max-width: 30em;
  }
  .h {
    color: var(--night-ink);
    margin-bottom: 6px;
  }
  .col a,
  .col button {
    color: var(--night-ink);
  }
  .col button {
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
  .col button[hidden] {
    display: none;
  }
  @media (max-width: 800px) {
    .col {
      grid-column: 1 / -1;
    }
    /* Thumb-sized rows. */
    .col a,
    .col button {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
    .col:has(a) {
      gap: 0;
    }
  }
</style>
