+void ChromeBrowserDelegate::NotifyTabStripChanged() {
+  if (browser_->IsDeleteScheduled()) {
+    return;
+  }
+  auto* model = browser_->tab_strip_model();
+  const int active = model->active_index();
+  for (int i = 0; i < model->count(); ++i) {
+    auto host =
+        ChromeBrowserHostImpl::GetBrowserForContents(model->GetWebContentsAt(i));
+    if (!host) {
+      continue;
+    }
+    if (auto client = host->GetClient()) {
+      if (auto handler = client->GetLifeSpanHandler()) {
+        handler->OnTabStripChanged(host.get(), i, i == active,
+                                   model->IsTabPinned(i));
+      }
+    }
+  }
+}
