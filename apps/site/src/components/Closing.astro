---
import DownloadButton from "./DownloadButton.astro";
import { DMG_SIZE, MIN_MACOS, RELEASES, VERSION } from "../data/release";
---

<section class="closing" aria-labelledby="closing-title" data-shot="closing">
  <div class="wrap closing-grid">
    <div class="closing-copy">
      <p class="label kicker">Election day is today</p>
      <h2 class="poster" id="closing-title" data-reveal>Elect it<br />default.</h2>
      <p class="lede" data-reveal style="--i: 1">
        Free, {DMG_SIZE}, and it leaves when asked: drag it to the Trash. We checked.
      </p>
      <div class="cta" data-reveal style="--i: 2">
        <DownloadButton label={`Download ${VERSION}`} meta="DMG" />
        <a class="link" href={RELEASES} rel="noopener">Release notes</a>
      </div>
      <p class="label fine">{MIN_MACOS} or later · Apple Silicon · <a class="link" href="#install">First launch help</a></p>
    </div>
    <div class="closing-stage" data-stage="closing" aria-hidden="true">
      <p class="victory label">Victory dance</p>
    </div>
  </div>
</section>

<style>
  .closing {
    padding: var(--section) 0 clamp(40px, 6vw, 80px);
  }
  .closing-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: end;
    border-top: 2px solid var(--ink);
    padding-top: clamp(40px, 6vw, 72px);
  }
  .closing-copy {
    grid-column: 1 / span 7;
    padding-bottom: 24px;
  }
  .kicker {
    color: var(--ink-2);
    margin-bottom: 20px;
  }
  h2 {
    font-size: clamp(3.6rem, 1rem + 11vw, 12rem);
    line-height: 0.82;
  }
  .lede {
    margin-top: 32px;
    font-size: var(--t-lede);
    max-width: 24em;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 32px;
  }
  .fine {
    margin-top: 22px;
    color: var(--ink-3);
  }
  .closing-stage {
    grid-column: 8 / -1;
    position: relative;
    height: clamp(400px, 72vh, 700px);
    border-bottom: 1px solid var(--rule-strong);
  }
  .closing-stage :global(.yahu-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .victory {
    position: absolute;
    right: 0;
    bottom: -28px;
    margin: 0;
    color: var(--ink-3);
  }
  /* Without the live model (no WebGL, save-data, or it hasn't loaded yet) the column stays empty
     rather than showing a frozen poster; the copy carries the section. */
  @media (max-width: 900px) {
    .closing-copy,
    .closing-stage {
      grid-column: 1 / -1;
    }
    .closing-stage {
      height: 76vw;
      margin-top: 24px;
    }
  }
</style>
