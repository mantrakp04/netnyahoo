+//     id, or 0.
+//   int cef_nn_load_open_url(int browser_id, int id): loads it in the browser
+//     (a new browser's about:blank entry is replaced, a page's isn't) and
+//     forgets it; 0 if the id is unknown.
+//   void cef_nn_forget_open_url(int id): drops it unused (its tab closed).
+//   int cef_nn_open_url_has_body(int id): 1 if it carries a POST body.
+// Entries wait until used or forgotten (a tab opened behind may load only
+// when first shown); past 200 entries or 64 MB the oldest go, those without a
+// body first.
+#define CEF_NN_OPEN_URL_PARAMS 1
+typedef int (*cef_nn_open_url_id_t)(void);
+typedef int (*cef_nn_load_open_url_t)(int browser_id, int id);
+typedef void (*cef_nn_forget_open_url_t)(int id);
+typedef int (*cef_nn_open_url_has_body_t)(int id);
+
+// CefLifeSpanHandler::OnBeforePopup's |extra_info| holds
+// "nn_opener_suppressed" (true) when the page asked for noopener or
+// noreferrer, and "nn_no_referrer" when it sent no referrer.
+#define CEF_NN_POPUP_OPENER_SUPPRESSED 1
