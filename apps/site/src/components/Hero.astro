---
import { Image } from "astro:assets";
import poster from "../assets/yahu-poster.webp";
import DownloadButton from "./DownloadButton.astro";
import { MIN_MACOS, REPO, VERSION } from "../data/release";
---

<section class="hero" id="top" data-shot="hero">
  <div class="wrap hero-grid">
    <h1 class="poster hero-title">
      <span class="line"><span>The browser</span></span>{" "}
      <span class="line"><span>that won’t</span></span>{" "}
      <span class="line"><span>leave office.</span></span>
    </h1>

    <div class="hero-copy">
      <p class="lede" data-reveal style="--i: 3">
        A Chromium browser for the Mac with tabs in the sidebar, split view, every Chrome extension and uBlock
        Origin built in. Make it your default. It will never step down.
      </p>
      <div class="cta-row" data-reveal style="--i: 4">
        <DownloadButton />
        <a class="link source" href={REPO} rel="noopener">Read the source</a>
      </div>
      <p class="label fine" data-reveal style="--i: 5">
        <span>v{VERSION}</span><span>Free</span><span>{MIN_MACOS}+</span><span>Apple Silicon</span>
      </p>
    </div>

    <figure class="hero-figure">
      <div class="stage" data-stage="hero">
        <Image
          class="stage-poster"
          src={poster}
          alt="Big Yahu, the Netnyahoo mascot: a glossy toy caricature of Benjamin Netanyahu in a dark suit and blue tie."
          widths={[400, 600, 800, 1120]}
          sizes="(max-width: 820px) 92vw, 560px"
          loading="eager"
          fetchpriority="high"
        />
        <p class="stamp" aria-hidden="true"><span>Incumbent</span></p>
      </div>
      <figcaption class="label stage-caption">
        <span>Fig. 1 — Big Yahu, candidate</span>
        <span class="hint">Drag to turn · click to dance</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(20px, 4.5vh, 64px);
    padding-bottom: clamp(48px, 8vh, 96px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
  }
  .hero-title {
    grid-column: 1 / span 8;
    grid-row: 1;
    position: relative;
    z-index: 1;
    font-size: clamp(3.2rem, min(9.6vw, 16vh), 10rem);
    line-height: 0.85;
    margin-left: -0.045em;
  }
  .line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
  }
  .line > span {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .line > span {
      animation: rise 1000ms var(--ease-out) both;
    }
    .js .line:nth-child(2) > span {
      animation-delay: 70ms;
    }
    .js .line:nth-child(3) > span {
      animation-delay: 140ms;
    }
  }
  @keyframes rise {
    from {
      transform: translateY(100%);
    }
  }

  .hero-copy {
    grid-column: 1 / span 6;
    grid-row: 2;
    position: relative;
    z-index: 3;
    align-self: end;
  }
  .lede {
    font-size: var(--t-lede);
    line-height: 1.36;
    max-width: 29em;
    margin-top: clamp(24px, 4.5vh, 48px);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: clamp(24px, 4vh, 40px);
  }
  .source {
    font-size: var(--t-small);
  }
  .fine {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin-top: 22px;
    color: var(--ink-3);
  }
  .fine span + span::before {
    content: "/";
    margin: 0 10px;
    color: var(--rule);
  }

  .hero-figure {
    grid-column: 7 / -1;
    grid-row: 1 / 3;
    align-self: end;
    justify-self: end;
    margin: 0;
    position: relative;
    z-index: 2;
    width: min(100%, 560px);
  }
  .stage {
    position: relative;
    height: clamp(420px, 66svh, 660px);
    cursor: grab;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
  }
  .stage:active {
    cursor: grabbing;
  }
  .stage-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
    transition: opacity 400ms var(--ease-out) 100ms;
    pointer-events: none;
  }
  .stage[data-live] .stage-poster {
    opacity: 0;
  }
  .stage :global(.yahu-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }
  .stage[data-live] :global(.yahu-canvas) {
    opacity: 1;
  }
  .stamp {
    position: absolute;
    right: 2%;
    top: 16%;
    margin: 0;
    transform: rotate(-9deg);
    pointer-events: none;
    font-family: var(--poster);
    font-weight: 850;
    font-stretch: 75%;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-size: clamp(0.85rem, 0.7rem + 0.5vw, 1.2rem);
    color: var(--stamp);
    border: 2.5px solid currentColor;
    padding: 3px;
    border-radius: 4px;
    mix-blend-mode: multiply;
    opacity: 0.9;
  }
  .stamp span {
    display: block;
    border: 1px solid currentColor;
    padding: 5px 12px 4px;
    border-radius: 2px;
  }
  .stage-caption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--rule-strong);
    padding-top: 10px;
    color: var(--ink-2);
  }
  .hint {
    color: var(--ink-3);
  }

  @media (max-width: 1100px) {
    .hero-copy {
      grid-column: 1 / span 7;
    }
    .hero-figure {
      grid-column: 6 / -1;
    }
  }
  @media (max-width: 820px) {
    .hero-grid {
      display: flex;
      flex-direction: column;
    }
    .hero-title {
      font-size: clamp(3.1rem, 16.4vw, 6.4rem);
    }
    .line {
      display: inline;
    }
    .line > span {
      display: inline;
    }
    .hero-copy {
      display: contents;
    }
    .hero-figure {
      order: 1;
      width: 100%;
      margin-top: 12px;
    }
    .stage {
      height: auto;
      aspect-ratio: 1 / 0.84;
    }
    .lede {
      order: 2;
      margin-top: 28px;
    }
    .cta-row {
      order: 3;
    }
    .fine {
      order: 4;
    }
    .hint {
      display: none;
    }
  }
  @media (max-width: 820px) and (prefers-reduced-motion: no-preference) {
    .js .line > span {
      animation: none;
    }
    .js .hero-title {
      animation: fade-up 900ms var(--ease-out) both;
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
