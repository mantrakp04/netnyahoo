+bool CefNativeWidgetMac::DefersToClient(bool is_before_first_responder) const {
+  // Netnyahoo: in the client's own window (CefBrowserSettings.client_window)
+  // the client's menus and views get keys first. Chrome's reserved commands
+  // (new/close tab or window, tab switching) would otherwise run before them,
+  // and swallow the key even while disabled. After them, Chrome's shortcuts
+  // still run (CefCommandHandler::OnChromeCommand can refuse them).
+  if (!is_before_first_responder || !browser_view_) {
+    return false;
+  }
+  auto* delegate = static_cast<ChromeBrowserDelegate*>(
+      browser_view_->browser()->cef_delegate());
+  return delegate && delegate->client_window();
+}
