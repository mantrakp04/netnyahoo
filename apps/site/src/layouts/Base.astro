---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/martian-mono/wdth.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import newsreaderLatin from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";
import martianLatin from "@fontsource-variable/martian-mono/files/martian-mono-latin-wdth-normal.woff2?url";
import "../styles/global.css";
import Visitor from "../components/Visitor.astro";

interface Props {
  title: string;
  description: string;
  /** schema.org objects for this page, as JSON-LD. */
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, jsonLd = [], noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
// Versioned by content: X and others cache a card image by its URL for days.
const ogVersion = createHash("sha256").update(readFileSync(`${process.cwd()}/public/og.png`)).digest("hex").slice(0, 10);
const og = new URL(`${base}/og.png?v=${ogVersion}`, Astro.site);
const OG_ALT = "Full immunity. Big Yahu, the Netnyahoo mascot, next to the words; netnyahoo, a free Chromium browser for the Mac.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f1ece2" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Netnyahoo" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={OG_ALT} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    {/* All three are on the first screen; preloading them keeps the hero from reflowing on swap. */}
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={martianLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <Visitor />
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/analytics";
      import "../scripts/send-to-mac";
      import "../scripts/lightbox";
    </script>
  </body>
</html>
