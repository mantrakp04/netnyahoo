+const extensions::Extension* EnabledExtension(content::WebContents* contents,
+                                              const CefString& extension_id) {
+  if (!contents) {
+    return nullptr;
+  }
+  return extensions::ExtensionRegistry::Get(contents->GetBrowserContext())
+      ->enabled_extensions()
+      .GetByID(extension_id.ToString());
+}
