+bool HandleDeviceChooser(
+    content::RenderFrameHost* owner,
+    std::unique_ptr<permissions::ChooserController>* controller,
+    base::OnceClosure* close_closure) {
+  CEF_REQUIRE_UIT();
+  auto handler = Handler();
+  auto browser =
+      owner ? BrowserFor(content::WebContents::FromRenderFrameHost(owner))
+            : nullptr;
+  if (!handler || !browser || !controller || !*controller) {
+    return false;
+  }
+  CefRefPtr<DeviceChooserImpl> chooser =
+      new DeviceChooserImpl(std::move(*controller));
+  DeviceChooserImpl::Live()[chooser->GetIdentifier()] = chooser;
+  if (!handler->OnDeviceChooser(browser.get(), chooser.get())) {
+    *controller = chooser->TakeController();
+    return false;
+  }
+  chooser->Announced();
+  *close_closure = base::BindOnce(
+      [](CefRefPtr<DeviceChooserImpl> chooser) { chooser->CloseFromChrome(); },
+      chooser);
+  return true;
+}
+
+bool WantsCastDialog(content::WebContents* initiator) {
+  return Handler() && BrowserFor(initiator);
+}
+
+bool HandleCastDialog(content::WebContents* initiator,
+                      media_router::MediaRouterUI* ui) {
+  CEF_REQUIRE_UIT();
+  auto handler = Handler();
+  auto browser = BrowserFor(initiator);
+  if (!handler || !browser || !ui) {
+    return false;
+  }
+  CefRefPtr<CastDialogImpl> dialog = new CastDialogImpl(initiator, ui);
+  CastDialogImpl::Live()[dialog->GetIdentifier()] = dialog;
+  if (!handler->OnCastDialog(browser.get(), dialog.get())) {
+    dialog->Detach();
+    return false;
+  }
+  dialog->Announced();
+  return true;
+}
+
+bool HandleExtensionSidePanel(BrowserWindowInterface* browser_window,
+                              content::WebContents* web_contents,
+                              const extensions::ExtensionId& extension_id,
+                              bool open) {
+  auto handler = Handler();
+  if (!handler) {
+    return false;
+  }
+  content::WebContents* contents = web_contents;
+  if (!contents && browser_window && browser_window->GetActiveTabInterface()) {
+    contents = browser_window->GetActiveTabInterface()->GetContents();
+  }
+  auto browser = BrowserFor(contents);
+  return browser &&
+         handler->OnExtensionSidePanel(browser.get(), extension_id, open);
+}
