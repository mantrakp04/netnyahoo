---
import { Picture } from "astro:assets";
import mark from "../assets/arcadia-mark.png";
import DownloadButton from "./DownloadButton.astro";
import MacOnlyNote from "./MacOnlyNote.astro";
import SendToMac from "./SendToMac.astro";
import { DMG_SIZE, MIN_MACOS, VERSION } from "../data/release";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="closing" aria-labelledby="closing-title" data-shot="closing">
  <div class="wrap closing-grid">
    <div class="closing-copy">
      <p class="label kicker">Election day is today</p>
      <h2 class="poster" id="closing-title" data-reveal>Impeach<br />Chrome.</h2>
      <p class="lede" data-reveal style="--i: 1">
        Make Arcadia your default. {DMG_SIZE}, no envelope required.
      </p>
      <SendToMac location="closing" />
      <div class="cta" data-reveal style="--i: 2">
        <DownloadButton label={`Download ${VERSION}`} meta="DMG" location="closing" class="not-phone" />
        <a class="link" href={`${base}/release-notes`}>Release notes</a>
      </div>
      <MacOnlyNote location="closing" />
      <p class="label fine not-phone">{MIN_MACOS} or later · Apple Silicon · Notarized by Apple</p>
    </div>
    <div class="closing-stage" data-tilt aria-hidden="true">
      <Picture
        class="closing-art"
        src={mark}
        alt=""
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[360, 560, 760, mark.width]}
        sizes="(max-width: 900px) 72vw, 560px"
        loading="lazy"
        decoding="async"
      />
      <p class="victory label">Polls close at sunset</p>
    </div>
  </div>
</section>

<style>
  .closing {
    padding: var(--section) 0 clamp(40px, 6vw, 80px);
  }
  .closing-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: end;
    border-top: 2px solid var(--ink);
    padding-top: clamp(40px, 6vw, 72px);
  }
  .closing-copy {
    grid-column: 1 / span 7;
    padding-bottom: 24px;
  }
  .kicker {
    color: var(--ink-2);
    margin-bottom: 20px;
  }
  h2 {
    font-size: clamp(3.6rem, 1rem + 11vw, 12rem);
    line-height: 0.82;
  }
  .lede {
    margin-top: 32px;
    font-size: var(--t-lede);
    max-width: 24em;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 32px;
  }
  .cta .link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .fine {
    margin-top: 22px;
    color: var(--ink-3);
  }
  /* The painted logo standing on the rule, level with the bottom of the copy. */
  .closing-stage {
    grid-column: 8 / -1;
    position: relative;
    padding: 0 2% 14px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .closing-art {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 22px rgb(32 63 50 / 0.16));
  }
  .victory {
    position: absolute;
    right: 0;
    bottom: -28px;
    margin: 0;
    color: var(--ink-3);
  }
  @media (max-width: 900px) {
    .closing-copy,
    .closing-stage {
      grid-column: 1 / -1;
    }
    .closing-stage {
      margin-top: 40px;
      padding: 0 14% 12px;
    }
  }
</style>
