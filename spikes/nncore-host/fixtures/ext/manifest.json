{
  "manifest_version": 3,
  "name": "NNCore spike extension",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "NNCore spike"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "panel.html"
  }
}
