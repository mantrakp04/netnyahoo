+bool HandleExtensionInstallPrompt(
+    Profile* profile,
+    content::WebContents* parent,
+    const extensions::InstallPromptData& prompt,
+    extensions::ExtensionInstallPromptClient::DoneCallback* done_callback) {
+  const extensions::Extension* extension = prompt.extension();
+  if (!extension || !done_callback || done_callback->is_null()) {
+    return false;
+  }
+
+  // The asking tab's request context handler, else the default one.
+  auto browser =
+      parent ? CefBrowserHostBase::GetBrowserForContents(parent) : nullptr;
+  CefRefPtr<CefRequestContextHandler> handler;
+  if (browser && browser->request_context()) {
+    handler = browser->request_context()->GetHandler();
+  }
+  if (!handler) {
+    if (auto app = CefAppManager::Get()->GetApplication()) {
+      if (auto bph = app->GetBrowserProcessHandler()) {
+        handler = bph->GetDefaultRequestContextHandler();
+      }
+    }
+  }
+  if (!handler) {
+    return false;
+  }
+
+  auto details = CefDictionaryValue::Create();
+  details->SetString("id", extension->id());
+  details->SetString("name", extension->name());
+  details->SetString("version", extension->VersionString());
+  details->SetString("type", PromptTypeName(prompt.type()));
+  std::string icon;
+  if (!prompt.icon().IsEmpty()) {
+    if (auto png = prompt.icon().As1xPNGBytes(); png && png->size()) {
+      icon = "data:image/png;base64," + base::Base64Encode(base::span<const uint8_t>(*png));
+    }
+  }
+  details->SetString("icon", icon);
+  auto permissions = CefListValue::Create();
+  for (size_t i = 0; i < prompt.GetPermissionCount(); ++i) {
+    permissions->SetString(i, prompt.GetPermission(i));
+  }
+  details->SetList("permissions", permissions);
+
+  CefRefPtr<ExtensionPromptCallbackImpl> callback =
+      new ExtensionPromptCallbackImpl(std::move(*done_callback));
+  if (handler->OnExtensionInstallPrompt(browser.get(), extension->id(), details,
+                                        callback.get())) {
+    return true;
+  }
+  // Not taken: give the callback back for Chrome's dialog.
+  *done_callback = callback->TakeDoneCallback();
+  return false;
+}
