---
import { Image, Picture } from "astro:assets";
import crowd from "../assets/game/crowd.webp";
import wanted from "../assets/game/wanted.webp";

// Where she is in this particular screenshot (fractions of the image).
const spot = { x: 0.193, y: 0.388, r: 0.04 };
---

<section class="game" id="game" aria-labelledby="game-title" data-shot="game">
  <div class="wrap">
    <div class="game-head">
      <div class="wanted">
        <Image src={wanted} alt="A painted notice nailed to a fence post: LOST, over a portrait of a black-faced lamb with a yellow bell." width={120} height={120} densities={[1, 2]} />
        <p class="label">Answers to<br />a yellow bell</p>
      </div>
      <div class="game-title">
        <p class="label kicker">The offline page</p>
        <h2 class="poster" id="game-title" data-reveal>Where’s the lamb?</h2>
      </div>
      <p class="game-copy" data-reveal style="--i: 1">
        Chrome gives you a dinosaur. We give you a hillside of sheep, goats and very helpful dogs, and one lamb
        with a yellow bell. Find her.
      </p>
    </div>

    <figure class="board" data-board>
      <div class="view">
      <div class="pan" data-pan>
      <div class="board-img" style={`aspect-ratio: ${crowd.width} / ${crowd.height}`}>
        <Picture
          src={crowd}
          alt="A screenshot of the game: a painted meadow packed with sheep, goats and sheepdogs, the lost lamb somewhere among them."
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[640, 1024, 1440, 2248]}
          sizes="(max-width: 700px) 240vw, (max-width: 1440px) 94vw, 1360px"
          loading="lazy"
        />
        <button
          class="found"
          type="button"
          data-found
          aria-label="That’s her. Reveal the lamb."
          style={`left: ${(spot.x - spot.r) * 100}%; top: ${spot.y * 100}%; width: ${spot.r * 200}%`}
        ></button>
      </div>
      </div>
        <p class="toast label" role="status" aria-live="polite" data-toast></p>
      </div>
      <figcaption class="label">
        <span>Fig. 8 — Level 1, 100 in the flock</span>
        <span class="swipe">Swipe the flock. She’s in there.</span>
        <span>Online too, at arcadia://game</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .game {
    padding: var(--section) 0 0;
  }
  .game-head {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "wanted title" "wanted copy";
    column-gap: clamp(20px, 3vw, 40px);
    row-gap: 24px;
    align-items: end;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .wanted {
    grid-area: wanted;
    align-self: start;
    text-align: center;
    border: 2px solid var(--ink);
    padding: 10px 10px 8px;
    background: #f9f5e3;
    transform: rotate(-3deg);
    width: clamp(96px, 12vw, 148px);
  }
  .wanted :global(img) {
    width: 100%;
    height: auto;
  }
  .wanted p {
    margin-top: 6px;
    font-size: 0.6rem;
    line-height: 1.3;
  }
  .game-title {
    grid-area: title;
  }
  .kicker {
    color: var(--ink-2);
    margin-bottom: 14px;
  }
  h2 {
    font-size: var(--t-h2);
  }
  .game-copy {
    grid-area: copy;
    max-width: 36em;
    color: var(--ink-2);
  }
  .board {
    position: relative;
    margin: 0;
    cursor: crosshair;
  }
  .board :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .view {
    position: relative;
  }
  .board-img {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
  }
  .swipe {
    display: none;
  }
  .found {
    position: absolute;
    aspect-ratio: 1;
    transform: translateY(-50%);
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: crosshair;
    padding: 0;
  }
  .found:focus-visible,
  .board[data-solved] .found {
    outline: 3px solid var(--stamp);
    outline-offset: 2px;
    box-shadow: 0 0 0 9999px rgb(22 19 15 / 0.55);
  }
  .toast {
    position: absolute;
    left: 16px;
    bottom: 16px;
    margin: 0;
    background: var(--ink);
    color: var(--paper);
    padding: 10px 14px;
    border-radius: 3px;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
    pointer-events: none;
  }
  .toast[data-show] {
    opacity: 1;
    transform: none;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 8px 24px;
    flex-wrap: wrap;
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px solid var(--rule-strong);
    color: var(--ink-2);
  }
  @media (max-width: 700px) {
    .game-head {
      grid-template-columns: 1fr auto;
      grid-template-areas: "title wanted" "copy copy";
    }
    /* On a phone the whole meadow is too small to search: show it big and let the flock pan. */
    .pan {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      border-radius: 6px;
      -webkit-overflow-scrolling: touch;
    }
    .pan::-webkit-scrollbar {
      display: none;
    }
    .board-img {
      width: 240%;
      border-radius: 0;
    }
    .board :global(img) {
      border-radius: 0;
    }
    .swipe {
      display: inline;
    }
    figcaption span:last-child:not(.swipe) {
      display: none;
    }
  }
</style>

<script>
  import { track } from "../scripts/track";

  const board = document.querySelector<HTMLElement>("[data-board]");
  const spot = board?.querySelector<HTMLButtonElement>("[data-found]");
  const toast = board?.querySelector<HTMLElement>("[data-toast]");
  // Phones: start at the far end of the meadow, so finding her takes a swipe.
  const pan = board?.querySelector<HTMLElement>("[data-pan]");
  if (pan && pan.scrollWidth > pan.clientWidth) pan.scrollLeft = pan.scrollWidth;
  if (board && spot && toast) {
    let started = 0;
    let misses = 0;
    new IntersectionObserver(([e], io) => {
      if (!e.isIntersecting) return;
      started = performance.now();
      io.disconnect();
    }, { threshold: 0.5 }).observe(board);

    const say = (text: string) => {
      toast.textContent = text;
      toast.setAttribute("data-show", "");
      clearTimeout(Number(toast.dataset.t));
      toast.dataset.t = String(setTimeout(() => toast.removeAttribute("data-show"), 2600));
    };
    // Once she's found, any click repeats the result: most solvers kept clicking a board that had gone quiet.
    let found = "";
    spot.addEventListener("click", (e) => {
      e.stopPropagation();
      if (found) return say(found);
      board.setAttribute("data-solved", "");
      const s = started ? ((performance.now() - started) / 1000).toFixed(1) : null;
      found = s ? `Found her in ${s} s. She hides better offline.` : "Found her. She hides better offline.";
      say(found);
      track("game_solved", { seconds: s ? Number(s) : null, misses });
    });
    const lines = ["Not her. That’s just the flock.", "Wrong woolly.", "Close. Look for the yellow bell.", "Not her. Keep looking."];
    board.addEventListener("click", () => say(found || lines[misses++ % lines.length]));
  }
</script>
