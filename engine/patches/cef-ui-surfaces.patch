+///
+/*--cef(added=experimental)--*/
+bool CefStopMediaCapture(CefRefPtr<CefBrowser> capturer);
+
+#endif  // CEF_API_ADDED(CEF_EXPERIMENTAL)
+
+#endif  // CEF_INCLUDE_CEF_CHROME_UI_H_
