+#ifndef CEF_INCLUDE_CEF_MEDIA_CAPTURE_H_
+#define CEF_INCLUDE_CEF_MEDIA_CAPTURE_H_
+#pragma once
+
+#include "include/cef_base.h"
+#include "include/cef_browser.h"
+
+#if CEF_API_ADDED(CEF_EXPERIMENTAL)
+///
+/// Returns a desktop media source id that captures the contents of |browser|
+/// (tab capture), in the form
+/// "web-contents-media-stream://<render process id>:<main frame routing id>".
+/// Pass it to getUserMedia() in any browser as the `chromeMediaSourceId`
+/// mandatory constraint together with `chromeMediaSource: "desktop"`, and
+/// allow the resulting CEF_MEDIA_PERMISSION_DESKTOP_VIDEO_CAPTURE request in
+/// CefPermissionHandler::OnRequestMediaAccessPermission. When the same request
+/// also asks for desktop audio (`audio: {mandatory: {chromeMediaSource:
+/// "desktop"}}`) the tab's own audio is captured instead of system audio.
+/// Capturing a tab needs no OS screen recording permission. The id is only
+/// valid while the browser's main frame lives in the same render process, so
+/// request it right before calling getUserMedia(). Returns an empty string if
+/// |browser| has no live main frame. Must be called on the browser process UI
+/// thread.
+///
+/*--cef(added=experimental)--*/
+CefString CefGetMediaCaptureSourceId(CefRefPtr<CefBrowser> browser);
+#endif
+
+#endif  // CEF_INCLUDE_CEF_MEDIA_CAPTURE_H_
