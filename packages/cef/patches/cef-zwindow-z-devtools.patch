+
+void ChromeBrowserDelegate::DevToolsDockChanged(
+    content::WebContents* inspected,
+    content::WebContents* devtools) {
+  if (!client_window_) {
+    return;
+  }
+  // The client hosts docked DevTools like the tab itself: no views::WebView
+  // attaches them (views::NativeHostedContents). Undocked, they show in their
+  // own DevTools window again.
+  auto it = docked_devtools_.find(inspected);
+  content::WebContents* previous =
+      it == docked_devtools_.end() ? nullptr : it->second.get();
+  if (previous && previous != devtools) {
+    views::NativeHostedContents::Unmark(previous);
+  }
+  if (devtools && devtools != previous) {
+    views::NativeHostedContents::Mark(devtools);
+  }
+  if (devtools) {
+    docked_devtools_[inspected] = devtools->GetWeakPtr();
+  } else if (it != docked_devtools_.end()) {
+    docked_devtools_.erase(it);
+  }
+  auto host = ChromeBrowserHostImpl::GetBrowserForContents(inspected);
+  auto client = host ? host->GetClient() : nullptr;
+  if (auto handler = client ? client->GetDisplayHandler() : nullptr) {
+    handler->OnDevToolsDockChanged(host.get());
+  }
