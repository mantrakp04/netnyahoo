+bool IsHiddenFromExtensions(const BrowserWindowInterface* browser) {
+  const Browser* chrome_browser = BrowserForBWI(browser);
+  auto* delegate = chrome_browser
+                       ? static_cast<ChromeBrowserDelegate*>(
+                             chrome_browser->cef_delegate())
+                       : nullptr;
+  return delegate && delegate->hidden_from_extensions();
+}
