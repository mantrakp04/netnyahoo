+CefString ChromeBrowserHostImpl::GetNavigationState() {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return CefString();
+  }
+  auto* web_contents = GetWebContents();
+  if (!web_contents) {
+    return CefString();
+  }
+  // What TabRestoreService records for a closed tab (TabRestoreServiceHelper).
+  auto& controller = web_contents->GetController();
+  const int pending_index = controller.GetPendingEntryIndex();
+  const int count = controller.GetEntryCount();
+  if (count == 0) {
+    return CefString();
+  }
+  base::Pickle pickle;
+  pickle.WriteInt(kNavigationStateVersion);
+  pickle.WriteInt(std::max(0, controller.GetCurrentEntryIndex()));
+  pickle.WriteInt(count);
+  for (int i = 0; i < count; ++i) {
+    content::NavigationEntry* entry = i == pending_index
+                                          ? controller.GetPendingEntry()
+                                          : controller.GetEntryAtIndex(i);
+    sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(i, entry)
+        .WriteToPickle(kMaxNavigationEntryBytes, &pickle);
+  }
+  return base::Base64Encode(pickle.AsBytes());
+}
+
+CefRefPtr<CefBrowser> ChromeBrowserHostImpl::DuplicateTab(
+    CefRefPtr<CefClient> client,
+    const CefBrowserSettings& settings,
+    CefRefPtr<CefDictionaryValue> extra_info) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return nullptr;
+  }
+  if (!browser_ || !browser_->cef_delegate() || !GetWebContents()) {
+    return nullptr;
+  }
+  auto* delegate = static_cast<ChromeBrowserDelegate*>(browser_->cef_delegate());
+  if (!delegate->native_contents_hosting()) {
+    return nullptr;
+  }
+  return delegate->DuplicateTab(GetWebContents(), client, settings, extra_info)
+      .get();
+}
+
+bool ChromeBrowserHostImpl::DiscardTab() {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+  auto* web_contents = GetWebContents();
+  auto* unit =
+      web_contents
+          ? resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+                web_contents)
+          : nullptr;
+  // EXTERNAL, like chrome.tabs.discard: the embedder asked for it.
+  return unit && unit->DiscardTab(
+                     ::mojom::LifecycleUnitDiscardReason::EXTERNAL);
+}
+
+bool ChromeBrowserHostImpl::IsTabDiscarded() {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+  auto* web_contents = GetWebContents();
+  auto* unit =
+      web_contents
+          ? resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+                web_contents)
+          : nullptr;
+  return unit &&
+         unit->GetTabState() == ::mojom::LifecycleUnitState::DISCARDED;
+}
+
+CefRefPtr<ChromeBrowserHostImpl> ChromeBrowserHostImpl::RestoreTabInBrowser(
+    CefRefPtr<CefClient> client,
+    const CefString& navigation_state,
+    const CefBrowserSettings& settings,
+    CefRefPtr<CefDictionaryValue> extra_info) {
+  CEF_REQUIRE_UIT();
+  if (!browser_ || !browser_->cef_delegate()) {
+    return nullptr;
+  }
+  auto* delegate = static_cast<ChromeBrowserDelegate*>(browser_->cef_delegate());
+  if (!delegate->native_contents_hosting()) {
+    LOG(ERROR) << "RestoreTabInBrowser requires a browser created with "
+                  "native_contents_hosting";
+    return nullptr;
+  }
+  std::vector<sessions::SerializedNavigationEntry> navigations;
+  int selected = 0;
+  if (!ParseNavigationState(navigation_state.ToString(), &navigations,
+                            &selected)) {
+    LOG(ERROR) << "RestoreTabInBrowser: invalid navigation state";
+    return nullptr;
+  }
+  return delegate->RestoreTab(navigations, selected, client, settings,
+                              extra_info);
+}
