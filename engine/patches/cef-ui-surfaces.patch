+bool CefChangeMediaCaptureSource(CefRefPtr<CefBrowser> capturer,
+                                 const CefString& source_id) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+  auto host = CefBrowserHostBase::FromBrowser(capturer);
+  const auto media_id = content::DesktopMediaID::Parse(source_id.ToString());
+  if (!host || media_id.type != content::DesktopMediaID::TYPE_WEB_CONTENTS) {
+    return false;
+  }
+  return host->GetMediaStreamRegistrar()->ChangeSource(media_id);
+}
+
+CefString CefGetMediaCaptureTarget(CefRefPtr<CefBrowser> capturer) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return CefString();
+  }
+  auto host = CefBrowserHostBase::FromBrowser(capturer);
+  if (!host) {
+    return CefString();
+  }
+  const auto media_id = host->GetMediaStreamRegistrar()->GetChangeableSource();
+  return media_id.is_null() ? CefString() : CefString(media_id.ToString());
+}
+
+bool CefStopMediaCapture(CefRefPtr<CefBrowser> capturer) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+  auto host = CefBrowserHostBase::FromBrowser(capturer);
+  return host && host->GetMediaStreamRegistrar()->StopScreenCaptures();
+}
