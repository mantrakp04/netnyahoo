+// Hands the client's decision back to ExtensionInstallPrompt. Cancels the
+// install if released without an answer.
+class ExtensionPromptCallbackImpl : public CefExtensionPromptCallback {
+ public:
+  using DoneCallback = extensions::ExtensionInstallPromptClient::DoneCallback;
+  using Payload = extensions::ExtensionInstallPromptClient::DoneCallbackPayload;
+  using Result = extensions::ExtensionInstallPromptClient::Result;
+
+  explicit ExtensionPromptCallbackImpl(DoneCallback done)
+      : done_(std::move(done)) {}
+  ExtensionPromptCallbackImpl(const ExtensionPromptCallbackImpl&) = delete;
+  ExtensionPromptCallbackImpl& operator=(const ExtensionPromptCallbackImpl&) =
+      delete;
+
+  ~ExtensionPromptCallbackImpl() override {
+    if (!done_.is_null()) {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(std::move(done_),
+                                            Payload(Result::USER_CANCELED)));
+    }
+  }
+
+  DoneCallback TakeDoneCallback() { return std::move(done_); }
+
+  void Continue(bool accepted) override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&ExtensionPromptCallbackImpl::Continue,
+                                            this, accepted));
+      return;
+    }
+    if (!done_.is_null()) {
+      std::move(done_).Run(
+          Payload(accepted ? Result::ACCEPTED : Result::USER_CANCELED));
+    }
+  }
+
+ private:
+  DoneCallback done_;
+
+  IMPLEMENT_REFCOUNTING(ExtensionPromptCallbackImpl);
+};
+
+std::string PromptTypeName(extensions::InstallPromptData::PromptType type) {
+  switch (type) {
+    case extensions::InstallPromptData::INSTALL_PROMPT:
+      return "install";
+    case extensions::InstallPromptData::RE_ENABLE_PROMPT:
+      return "re-enable";
+    case extensions::InstallPromptData::PERMISSIONS_PROMPT:
+      return "permissions";
+    case extensions::InstallPromptData::EXTERNAL_INSTALL_PROMPT:
+      return "external";
+    case extensions::InstallPromptData::REMOTE_INSTALL_PROMPT:
+      return "remote";
+    case extensions::InstallPromptData::REPAIR_PROMPT:
+      return "repair";
+    default:
+      return "other";
+  }
+}
