-void CefMediaStreamRegistrar::UnregisterMediaStream(const std::string& label) {
+void CefMediaStreamRegistrar::DropReplacedStream(const std::string& label) {
   CEF_REQUIRE_UIT();
-  registered_streams_.erase(label);
+  auto it = registered_streams_.find(label);
+  if (it == registered_streams_.end() || it->second.ui_id != 0) {
+    return;
+  }
+  changing_.erase(label);
+  registered_streams_.erase(it);
   NotifyMediaStreamChange();
 }
 
+bool CefMediaStreamRegistrar::ChangeSource(
+    const content::DesktopMediaID& media_id) {
+  CEF_REQUIRE_UIT();
+  bool changed = false;
+  for (auto& [label, stream] : registered_streams_) {
+    if (!stream.source.is_null()) {
+      changing_.insert(label);
+      stream.source.Run(media_id, /*captured_surface_control_active=*/false);
+      changed = true;
+    }
+  }
+  return changed;
+}
+
+content::DesktopMediaID CefMediaStreamRegistrar::GetChangeableSource() const {
+  CEF_REQUIRE_UIT();
+  for (const auto& [label, stream] : registered_streams_) {
+    if (stream.source.is_null()) {
+      continue;
+    }
+    for (const auto& id : stream.captured) {
+      if (id.type == content::DesktopMediaID::TYPE_WEB_CONTENTS) {
+        return id;
+      }
+    }
+  }
+  return content::DesktopMediaID();
+}
+
+bool CefMediaStreamRegistrar::StopScreenCaptures() {
+  CEF_REQUIRE_UIT();
+  std::vector<base::RepeatingClosure> stops;
+  for (const auto& [label, stream] : registered_streams_) {
+    if (!stream.captured.empty() && !stream.stop.is_null()) {
+      stops.push_back(stream.stop);
+    }
+  }
+  // Stopping unregisters streams: run the closures after the loop.
+  for (auto& stop : stops) {
+    stop.Run();
+  }
+  return !stops.empty();
+}
