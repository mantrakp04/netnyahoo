---
import { Image } from "astro:assets";
import icon from "../assets/app-icon.png";
import { DMG, REPO } from "../data/release";

interface Props {
  /** Where the section links point: "" on the home page itself, the home page's URL elsewhere. */
  home?: string;
}
const { home = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="bar" data-bar>
  <div class="wrap bar-inner">
    <a class="mark" href={`${home}#top`} aria-label={home ? "Netnyahoo home" : "Netnyahoo, back to top"}>
      <Image src={icon} alt="" width={30} height={30} densities={[1, 2]} loading="eager" />
      <span>netnyahoo</span>
    </a>
    <nav class="links" aria-label="Sections">
      <a href={`${home}#platform`}>Platform</a>
      <a href={`${home}#record`}>Record</a>
      <a href={`${home}#game`}>Game</a>
      <a href={`${home}#press`}>Press</a>
      <a href={`${base}/release-notes`}>Notes</a>
      <a href={REPO} rel="noopener">GitHub</a>
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>Menu</button>
    <a class="bar-cta" href={DMG} data-download>Download</a>
  </div>
  <nav class="menu" id="menu" aria-label="Sections" data-menu hidden>
    <div class="wrap">
      <a href={`${home}#platform`}>Platform</a>
      <a href={`${home}#record`}>Record</a>
      <a href={`${home}#game`}>Game</a>
      <a href={`${home}#press`}>Press</a>
      <a href={`${base}/release-notes`}>Release notes</a>
      <a href={REPO} rel="noopener">GitHub</a>
    </div>
  </nav>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms;
  }
  .bar[data-scrolled] {
    border-bottom-color: var(--rule);
  }
  .bar-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--poster);
    font-weight: 880;
    font-stretch: 112%;
    font-size: 1.3rem;
    letter-spacing: -0.035em;
    line-height: 1;
    margin-right: auto;
    min-height: 44px;
  }
  .mark img {
    width: 30px;
    height: 30px;
  }
  .links {
    display: flex;
    gap: 26px;
  }
  .links a {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-stretch: 87.5%;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 150ms;
  }
  .links a:hover {
    color: var(--ink);
  }
  .bar-cta {
    font-family: var(--poster);
    font-weight: 760;
    font-stretch: 80%;
    text-transform: uppercase;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    background: var(--ink);
    color: var(--paper);
    padding: 9px 14px 8px;
    border-radius: 3px;
    transition: background-color 150ms;
  }
  .bar-cta:hover {
    background: var(--tie);
  }

  /* Phones: the section links fold into a menu under the bar. */
  .menu-btn,
  .menu {
    display: none;
  }
  @media (max-width: 820px) {
    .bar-inner {
      gap: 8px;
    }
    .links {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 12px;
      border: 0;
      background: none;
      color: var(--ink);
      font-family: var(--mono);
      font-size: 0.72rem;
      font-stretch: 87.5%;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      touch-action: manipulation;
    }
    .bar-cta {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 16px;
    }
    .menu:not([hidden]) {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--rule-strong);
      padding: 4px 0 20px;
      animation: drop 220ms var(--ease-out) both;
    }
    .menu a {
      display: flex;
      align-items: center;
      min-height: 56px;
      border-top: 1px solid var(--rule);
      font-family: var(--poster);
      font-weight: 860;
      font-stretch: 62%;
      text-transform: uppercase;
      font-size: 2rem;
      line-height: 1;
      text-decoration: none;
    }
    .menu a:first-child {
      border-top: 0;
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>("[data-bar]")!;
  const onScroll = () => bar.toggleAttribute("data-scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const btn = bar.querySelector<HTMLButtonElement>("[data-menu-btn]")!;
  const menu = bar.querySelector<HTMLElement>("[data-menu]")!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute("aria-expanded", String(open));
    btn.textContent = open ? "Close" : "Menu";
  };
  btn.addEventListener("click", () => setOpen(menu.hidden));
  menu.addEventListener("click", (e) => (e.target as Element).closest("a") && setOpen(false));
  addEventListener("keydown", (e) => e.key === "Escape" && !menu.hidden && (setOpen(false), btn.focus()));
  matchMedia("(min-width: 821px)").addEventListener("change", (e) => e.matches && setOpen(false));
</script>
