# Copyright 2026 Netnyahoo. Apache-2.0.
#
# //chrome/browser/netnyahoo: Netnyahoo's own code in the Chromium tree. Plain
# Chromium code over Chrome's services, exported as plain C (public/nn_engine.h)
# and linked by both engines: CEF's libcef_static and NNCore's //chrome:chrome_dll
# (hooks in engine/chromium/apply.sh). The repo copy is engine/chromium/src;
# never edit the tree's copy.
#
# One source_set: add your nn_<domain>.{h,cc} to `sources` (sorted) and the
# deps it needs. Nothing in //chrome depends on this target.

assert(is_mac)

source_set("netnyahoo") {
  sources = [
    "nn_autofill.cc",
    "nn_autofill.h",
    "nn_browsing_data.cc",
    "nn_browsing_data.h",
    "nn_engine.cc",
    "nn_engine.h",
    "nn_extensions.cc",
    "nn_extensions.h",
    "nn_passwords.cc",
    "nn_passwords.h",
    "nn_reauth.cc",
    "nn_reauth.h",
    "nn_search_engines.cc",
    "nn_search_engines.h",
    "nn_zoom.cc",
    "nn_zoom.h",
    "pip/nn_pip_controls.cc",
    "pip/nn_pip_controls.h",
    "pip/nn_pip_mac.h",
    "pip/nn_pip_mac.mm",
    "pip/nn_pip_window.cc",
    "pip/nn_pip_window.h",
    "public/nn_engine.h",
  ]

  deps = [
    "//base",
    "//cc/paint",
    "//chrome/app:generated_resources",
    "//chrome/browser",
    "//chrome/browser/autofill",
    "//chrome/browser/browsing_data:constants",
    "//chrome/browser/device_reauth",
    "//chrome/browser/extensions",
    "//chrome/browser/extensions/api/passwords_private",
    "//chrome/browser/picture_in_picture",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/views/overlay",
    "//chrome/common",
    "//chrome/common/extensions/api",
    "//components/autofill/core/browser",
    "//components/autofill/core/common",
    "//components/browsing_data/core",
    "//components/device_reauth",
    "//components/password_manager/core/browser",
    "//components/password_manager/core/common",
    "//components/search_engines",
    "//components/strings",
    "//content/public/browser",
    "//extensions/browser",
    "//extensions/common",
    "//services/media_session/public/cpp",
    "//skia",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/views",
  ]

  # pip/: the Picture in Picture window's Core Animation fade.
  frameworks = [ "QuartzCore.framework" ]
}

# Chrome's framework exports only what its lists name; NNCore's framework also
# exports every nn_* call. CEF's framework exports default-visibility symbols
# already, and an exports list there would hide CEF's own API, so only
# //chrome:chrome_dll depends on this.
config("exports_config") {
  ldflags = [ "-Wl,-exported_symbols_list," +
              rebase_path("nn_engine.exports", root_build_dir) ]
}

group("exports") {
  all_dependent_configs = [ ":exports_config" ]
  public_deps = [ ":netnyahoo" ]
}
