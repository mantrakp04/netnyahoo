+CefWindowHandle CefBrowserHostBase::GetDockedDevTools(
+    const CefSize& container_size,
+    CefRect& inspected_bounds) {
+  inspected_bounds = CefRect();
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return kNullWindowHandle;
+  }
+  auto* web_contents = GetWebContents();
+  if (!web_contents || IsWindowless()) {
+    return kNullWindowHandle;
+  }
+  DevToolsContentsResizingStrategy strategy;
+  auto* devtools = DevToolsWindow::GetInTabWebContents(web_contents, &strategy);
+  // Only DevTools the client shows (a client window's; see
+  // ChromeBrowserDelegate::DevToolsDockChanged).
+  if (!devtools || !views::NativeHostedContents::IsMarked(devtools)) {
+    return kNullWindowHandle;
+  }
+  gfx::Rect devtools_bounds, contents_bounds;
+  ApplyDevToolsContentsResizingStrategy(
+      strategy, gfx::Rect(container_size.width, container_size.height),
+      &devtools_bounds, &contents_bounds);
+  if (!strategy.hide_inspected_contents()) {
+    inspected_bounds = CefRect(contents_bounds.x(), contents_bounds.y(),
+                               contents_bounds.width(), contents_bounds.height());
+  }
+  return view_util::GetViewHandle(devtools->GetNativeView());
+}
