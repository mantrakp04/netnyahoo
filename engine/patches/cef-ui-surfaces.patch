+///
+/// Chrome style only. Chrome's device chooser: a site asked for a Bluetooth
+/// device (navigator.bluetooth.requestDevice / requestLEScan), a USB, HID or
+/// serial device. Handed to CefChromeUIHandler::OnDeviceChooser instead of
+/// Chrome's bubble. Use it on the browser process UI thread. Answer with
+/// Select or Cancel exactly once; it stops being open when answered or when
+/// Chrome closes it (the page navigated or gave up).
+///
+/*--cef(source=library,added=experimental)--*/
+class CefDeviceChooser : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// Returns an identifier unique for this run of the browser.
+  ///
+  /*--cef()--*/
+  virtual int GetIdentifier() = 0;
+
+  ///
+  /// Returns true until the chooser is answered or closed.
+  ///
+  /*--cef()--*/
+  virtual bool IsOpen() = 0;
+
+  ///
+  /// Returns what Chrome's chooser would show: "title" (includes the site),
+  /// "okLabel", "cancelLabel", "noOptionsText", "scanningText" (the throbber
+  /// label), "refreshing", "canRefresh", "adapterOff" (Bluetooth is off),
+  /// "unauthorized" (the app lacks the OS Bluetooth permission),
+  /// "bothButtonsEnabled" (a scanning prompt: OK and Cancel are Allow and
+  /// Block), "showSignal", and "options": a list of dictionaries with "name",
+  /// "connected", "paired" and "signal" (0-4, -1 for none).
+  ///
+  /*--cef()--*/
+  virtual CefRefPtr<CefDictionaryValue> GetState() = 0;
+
+  ///
+  /// Grants the site the option at |index| (for a scanning prompt any index
+  /// allows it).
+  ///
+  /*--cef()--*/
+  virtual void Select(int index) = 0;
+
+  ///
+  /// Denies the request.
+  ///
+  /*--cef()--*/
+  virtual void Cancel() = 0;
+
+  ///
+  /// Scans again (when "canRefresh").
+  ///
+  /*--cef()--*/
+  virtual void Refresh() = 0;
+
+  ///
+  /// Opens the OS settings that grant the app Bluetooth access (for
+  /// "unauthorized").
+  ///
+  /*--cef()--*/
+  virtual void OpenPermissionSettings() = 0;
+};
+
+///
+/// Chrome style only. Chrome's Cast dialog for a tab (its Media Router UI):
+/// the sinks Chrome found and what casting to each would do. Handed to
+/// CefChromeUIHandler::OnCastDialog instead of Chrome's dialog, both when the
+/// client asks (CefShowCastDialog) and when a page does (Presentation API,
+/// Cast SDK buttons). Use it on the browser process UI thread.
+///
+/*--cef(source=library,added=experimental)--*/
+class CefCastDialog : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// Returns an identifier unique for this run of the browser.
+  ///
+  /*--cef()--*/
+  virtual int GetIdentifier() = 0;
+
+  ///
+  /// Returns true until the dialog is closed (Close, or Chrome closed it).
+  ///
+  /*--cef()--*/
+  virtual bool IsOpen() = 0;
+
+  ///
+  /// Returns Chrome's dialog model: "header" (the source, e.g. "Cast tab"),
+  /// "permissionRejected" (the OS denied local network access) and "sinks": a
+  /// list of dictionaries with "id", "name", "status" (Chrome's status line),
+  /// "state" ("available", "connecting", "connected", "disconnecting" or
+  /// "unavailable"), "icon" (media_router::SinkIconType), "modes" (bitmask of
+  /// media_router::MediaCastMode: 1 presentation, 2 tab, 4 screen, 8 remote
+  /// playback), "routeId" (the active route, or empty) and "issue" (an error
+  /// title, or empty).
+  ///
+  /*--cef()--*/
+  virtual CefRefPtr<CefDictionaryValue> GetState() = 0;
+
+  ///
+  /// Starts casting to |sink_id| in |cast_mode| (one of the "modes" bits).
+  ///
+  /*--cef()--*/
+  virtual void StartCasting(const CefString& sink_id, int cast_mode) = 0;
+
+  ///
+  /// Stops the route |route_id|.
+  ///
+  /*--cef()--*/
+  virtual void StopCasting(const CefString& route_id) = 0;
+
+  ///
+  /// Closes the dialog (a pending Presentation API request is rejected).
+  ///
+  /*--cef()--*/
+  virtual void Close() = 0;
+};
+
+///
+/// Chrome style only. Implement to draw Chrome UI surfaces the hidden Chrome
+/// window can't show (see CefSetChromeUIHandler). Called on the browser
+/// process UI thread.
+///
+/*--cef(source=client,added=experimental)--*/
+class CefChromeUIHandler : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// A site asked for a device (see CefDeviceChooser) from |browser|. Return
+  /// true to show your own chooser (then answer through |chooser|), or false
+  /// for Chrome's.
+  ///
+  /*--cef()--*/
+  virtual bool OnDeviceChooser(CefRefPtr<CefBrowser> browser,
+                               CefRefPtr<CefDeviceChooser> chooser) {
+    return false;
+  }
+
+  ///
+  /// |chooser|'s options, scanning state or adapter state changed, or it
+  /// closed (IsOpen() is false).
+  ///
+  /*--cef()--*/
+  virtual void OnDeviceChooserChanged(CefRefPtr<CefDeviceChooser> chooser) {}
+
+  ///
+  /// Chrome would show its Cast dialog for |browser|. Return true to show your
+  /// own (driven by |dialog|), or false for Chrome's.
+  ///
+  /*--cef()--*/
+  virtual bool OnCastDialog(CefRefPtr<CefBrowser> browser,
+                            CefRefPtr<CefCastDialog> dialog) {
+    return false;
+  }
+
+  ///
+  /// |dialog|'s model changed, or it closed (IsOpen() is false).
+  ///
+  /*--cef()--*/
+  virtual void OnCastDialogChanged(CefRefPtr<CefCastDialog> dialog) {}
+
+  ///
+  /// Chrome would open (|open| true) or close the side panel of the extension
+  /// |extension_id| (chrome.sidePanel.open / close) in the window of
+  /// |browser|, the tab it's for. Return true if you show extension side
+  /// panels yourself (see CefGetExtensionSidePanel); Chrome's side panel then
+  /// stays closed.
+  ///
+  /*--cef()--*/
+  virtual bool OnExtensionSidePanel(CefRefPtr<CefBrowser> browser,
+                                    const CefString& extension_id,
+                                    bool open) {
+    return false;
+  }
+};
+
+///
+/// Sets the handler for Chrome UI surfaces (an empty |handler| restores
+/// Chrome's own). Call on the browser process UI thread.
+///
+/*--cef(added=experimental,optional_param=handler)--*/
+void CefSetChromeUIHandler(CefRefPtr<CefChromeUIHandler> handler);
