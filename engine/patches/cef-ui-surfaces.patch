+class CastDialogImpl : public CefCastDialog,
+                       public media_router::CastDialogController::Observer {
+ public:
+  CastDialogImpl(content::WebContents* initiator,
+                 media_router::MediaRouterUI* ui)
+      : initiator_(initiator->GetWeakPtr()), ui_(ui->GetWeakPtr()) {
+    static int last_id = 0;
+    id_ = ++last_id;
+    // Reports the current model right away.
+    ui->AddObserver(this);
+  }
+  CastDialogImpl(const CastDialogImpl&) = delete;
+  CastDialogImpl& operator=(const CastDialogImpl&) = delete;
+
+  ~CastDialogImpl() override { Detach(); }
+
+  static std::map<int, CefRefPtr<CastDialogImpl>>& Live() {
+    static base::NoDestructor<std::map<int, CefRefPtr<CastDialogImpl>>> live;
+    return *live;
+  }
+
+  void Announced() { announced_ = true; }
+
+  void Detach() {
+    if (ui_) {
+      ui_->RemoveObserver(this);
+      ui_.reset();
+    }
+    open_ = false;
+    Live().erase(id_);
+  }
+
+  // CefCastDialog:
+  int GetIdentifier() override { return id_; }
+  bool IsOpen() override { return open_; }
+
+  CefRefPtr<CefDictionaryValue> GetState() override {
+    auto state = state_ ? state_->Copy(false) : CefDictionaryValue::Create();
+    state->SetBool("open", open_);
+    state->SetBool("castingStarted", casting_started_);
+    return state;
+  }
+
+  void StartCasting(const CefString& sink_id, int cast_mode) override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&CastDialogImpl::StartCasting,
+                                            this, sink_id, cast_mode));
+      return;
+    }
+    if (ui_) {
+      ui_->StartCasting(sink_id.ToString(),
+                        static_cast<media_router::MediaCastMode>(cast_mode));
+    }
+  }
+
+  void StopCasting(const CefString& route_id) override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&CastDialogImpl::StopCasting,
+                                            this, route_id));
+      return;
+    }
+    if (ui_) {
+      ui_->StopCasting(route_id.ToString());
+    }
+  }
+
+  void Close() override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&CastDialogImpl::Close, this));
+      return;
+    }
+    if (!open_) {
+      return;
+    }
+    CefRefPtr<CastDialogImpl> self(this);
+    // Destroys the MediaRouterUI (OnControllerDestroying).
+    if (initiator_) {
+      media_router::MediaRouterDialogController::GetOrCreateForWebContents(
+          initiator_.get())
+          ->HideMediaRouterDialog();
+    }
+    if (open_) {
+      Detach();
+      Notify();
+    }
+  }
+
+  // media_router::CastDialogController::Observer:
+  void OnModelUpdated(const media_router::CastDialogModel& model) override {
+    auto state = CefDictionaryValue::Create();
+    state->SetString("header", model.dialog_header());
+    state->SetBool("permissionRejected", model.is_permission_rejected());
+    auto sinks = CefListValue::Create();
+    for (const auto& sink : model.media_sinks()) {
+      auto item = CefDictionaryValue::Create();
+      item->SetString("id", sink.id);
+      item->SetString("name", sink.friendly_name);
+      item->SetString("status", sink.GetStatusTextForDisplay());
+      item->SetString("state", SinkState(sink.state));
+      item->SetInt("icon", static_cast<int>(sink.icon_type));
+      int modes = 0;
+      for (auto mode : sink.cast_modes) {
+        modes |= static_cast<int>(mode);
+      }
+      item->SetInt("modes", modes);
+      item->SetString("routeId",
+                      sink.route ? sink.route->media_route_id() : std::string());
+      item->SetString("issue",
+                      sink.issue ? sink.issue->info().title : std::string());
+      sinks->SetDictionary(sinks->GetSize(), item);
+    }
+    state->SetList("sinks", sinks);
+    state_ = state;
+    Notify();
+  }
+
+  void OnCastingStarted() override {
+    casting_started_ = true;
+    Notify();
+  }
+
+  void OnControllerDestroying() override {
+    CefRefPtr<CastDialogImpl> self(this);
+    ui_.reset();
+    Detach();
+    Notify();
+  }
+
+ private:
+  void Notify() {
+    if (announced_ && Handler()) {
+      Handler()->OnCastDialogChanged(this);
+    }
+  }
+
+  base::WeakPtr<content::WebContents> initiator_;
+  base::WeakPtr<media_router::MediaRouterUI> ui_;
+  CefRefPtr<CefDictionaryValue> state_;
+  int id_;
+  bool open_ = true;
+  bool announced_ = false;
+  bool casting_started_ = false;
+
+  IMPLEMENT_REFCOUNTING(CastDialogImpl);
+};
