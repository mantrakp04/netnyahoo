+void ChromeBrowserHostImpl::SetTabIndex(int index) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return;
+  }
+  const int from = GetCurrentTabIndex();
+  if (from == TabStripModel::kNoTab) {
+    return;
+  }
+  auto* model = browser_->tab_strip_model();
+  const int to = std::clamp(index, 0, model->count() - 1);
+  if (to != from) {
+    model->MoveWebContentsAt(from, to, /*select_after_move=*/false);
+  }
+}
