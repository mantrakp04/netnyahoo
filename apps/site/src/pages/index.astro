---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import InOffice from "../components/InOffice.astro";
import Platform from "../components/Platform.astro";
import Record from "../components/Record.astro";
import Game from "../components/Game.astro";
import Press from "../components/Press.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Netnyahoo — the browser that won’t leave office"
  description="A free, open-source Chromium browser for the Mac: sidebar tabs, split view, profiles, every Chrome extension and uBlock Origin built in. Make it your default. It will never step down."
>
  <Header />
  <main>
    <Hero />
    <InOffice />
    <Platform />
    <Record />
    <Game />
    <Press />
    <Closing />
  </main>
  <Footer />
</Base>

<script>
  import "../scripts/motion";
  import "../scripts/stage";
</script>
