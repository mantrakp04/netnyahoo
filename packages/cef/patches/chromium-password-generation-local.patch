+// Netnyahoo has no account to save to: generated passwords stay on this
+// device, like its other passwords, so the popup says so (Chrome's local-only
+// footer) instead of naming Google Password Manager and an empty account.
+int SavedWhereMessage(const std::u16string& email) {
+  return email.empty() ? IDS_PASSWORD_BUBBLES_FOOTER_SAVING_ON_DEVICE
+                       : IDS_PASSWORD_GENERATION_PROMPT_GOOGLE_PASSWORD_MANAGER;
+}
+int PasswordManagerName(const std::u16string& email) {
+  return email.empty()
+             ? IDS_PASSWORD_MANAGER_BRAND_NAME
+             : IDS_PASSWORD_BUBBLES_PASSWORD_MANAGER_LINK_TEXT_SYNCED_TO_ACCOUNT;
+}
