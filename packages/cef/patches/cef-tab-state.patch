+// Runs the client's callback once Chrome's BrowsingDataRemover is done with
+// the task it was passed to (the remover only reports to registered
+// observers).
+class BrowsingDataDone : public content::BrowsingDataRemover::Observer {
+ public:
+  BrowsingDataDone(content::BrowsingDataRemover* remover,
+                   CefRefPtr<CefCompletionCallback> callback)
+      : remover_(remover), callback_(callback) {
+    if (remover_) {
+      remover_->AddObserver(this);
+    }
+  }
+
+  void OnBrowsingDataRemoverDone(uint64_t failed_data_types) override {
+    if (remover_) {
+      remover_->RemoveObserver(this);
+    }
+    if (callback_) {
+      callback_->OnComplete();
+    }
+    delete this;
+  }
+
+ private:
+  const raw_ptr<content::BrowsingDataRemover> remover_;
+  CefRefPtr<CefCompletionCallback> callback_;
+};
+
+}  // namespace
+
+void CefRequestContextImpl::ClearBrowsingDataInternal(
+    int data_types,
+    base::Time begin,
+    base::Time end,
+    CefRefPtr<CefCompletionCallback> callback,
+    CefBrowserContext::Getter browser_context_getter) {
+  auto browser_context = browser_context_getter.Run();
+  if (!browser_context) {
+    return;
+  }
+
+  // The categories of Chrome's "Delete browsing data" dialog.
+  uint64_t remove_mask = 0;
+  if (data_types & CEF_NN_BROWSING_DATA_HISTORY) {
+    remove_mask |= chrome_browsing_data_remover::DATA_TYPE_HISTORY;
+  }
+  if (data_types & CEF_NN_BROWSING_DATA_SITE_DATA) {
+    remove_mask |= chrome_browsing_data_remover::DATA_TYPE_SITE_DATA;
+  }
+  if (data_types & CEF_NN_BROWSING_DATA_CACHE) {
+    remove_mask |= content::BrowsingDataRemover::DATA_TYPE_CACHE;
+  }
+  if (data_types & CEF_NN_BROWSING_DATA_DOWNLOADS) {
+    remove_mask |= content::BrowsingDataRemover::DATA_TYPE_DOWNLOADS;
+  }
+  if (!remove_mask) {
+    if (callback) {
+      callback->OnComplete();
+    }
+    return;
+  }
+  auto* remover = browser_context->AsBrowserContext()->GetBrowsingDataRemover();
+  remover->RemoveAndReply(
+      begin, end.is_null() ? base::Time::Max() : end, remove_mask,
+      content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB,
+      new BrowsingDataDone(remover, callback));
 }
 
