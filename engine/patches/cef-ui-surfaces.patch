+
+std::string PngDataUrl(const gfx::Image& image) {
+  if (image.IsEmpty()) {
+    return std::string();
+  }
+  // The toolbar draws on Retina screens: the 2x representation (scaled from 1x
+  // if the extension gave only that).
+  const gfx::ImageSkiaRep& rep = image.ToImageSkia()->GetRepresentation(2.0f);
+  auto png = gfx::PNGCodec::EncodeBGRASkBitmap(rep.GetBitmap(),
+                                               /*discard_transparency=*/false);
+  if (!png) {
+    return std::string();
+  }
+  return "data:image/png;base64," + base::Base64Encode(*png);
+}
