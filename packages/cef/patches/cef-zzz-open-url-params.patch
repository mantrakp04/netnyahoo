+// A navigation Chrome asks to open in a new tab or window
+// (CefRequestHandler::OnOpenURLFromTab with NEW_FOREGROUND_TAB,
+// NEW_BACKGROUND_TAB, NEW_WINDOW or NEW_SPLIT_VIEW) keeps its full parameters: a POST body,
+// referrer and initiator. C functions exported by the framework, outside
+// the translated API (look them up with dlsym), on the UI thread:
+//   int cef_nn_open_url_id(void): inside OnOpenURLFromTab, that navigation's
+//     id, or 0.
+//   int cef_nn_load_open_url(int browser_id, int id): loads it in the browser
+//     (a new browser's about:blank entry is replaced, a page's isn't) and
+//     forgets it; 0 if the id is unknown.
+//   void cef_nn_forget_open_url(int id): drops it unused (its tab closed).
+// Entries wait until used or forgotten (a tab opened behind may load only
+// when first shown); past 200 the oldest go.
+#define CEF_NN_OPEN_URL_PARAMS 1
+typedef int (*cef_nn_open_url_id_t)(void);
+typedef int (*cef_nn_load_open_url_t)(int browser_id, int id);
+typedef void (*cef_nn_forget_open_url_t)(int id);
+
+// CefLifeSpanHandler::OnBeforePopup's |extra_info| holds
+// "nn_opener_suppressed" (true) when the page asked for noopener or
+// noreferrer, and "nn_no_referrer" when it sent no referrer.
+#define CEF_NN_POPUP_OPENER_SUPPRESSED 1
+
+// With CefSettings.external_message_pump, CefDoMessageLoopWork() ends by
+// calling CefBrowserProcessHandler::OnScheduleMessagePumpWork() for its next
+// call: 0 when work is left over from its time slice, or the delay until the
+// next delayed task. A client needs no poll of its own to run delayed tasks.
+#define CEF_NN_PUMP_SCHEDULE 1
+
 #endif  // CEF_INCLUDE_CEF_NETNYAHOO_H_
