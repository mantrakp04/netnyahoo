---
// Phones and tablets only (data-device="phone", Visitor.astro): the app is Mac-only, so instead of a Download
// button they get "Send to my Mac" (the share sheet, or email without one), then Share / Copy link / Email it
// to me. Behaviour and events live in scripts/send-to-mac.ts.
interface Props {
  /** Where on the site it is, for analytics (send_to_mac_clicked). */
  location: "hero" | "closing" | "release_notes";
  /** The page's main panel: the header's "Send to my Mac" scrolls here. */
  main?: boolean;
}
const { location, main = false } = Astro.props;
const email = `mailto:?subject=${encodeURIComponent("Netnyahoo, for my Mac")}&body=${encodeURIComponent(
  "Open this on your Mac: https://netnyahoo.com/?ref=email",
)}`;
---

<div class="send phone-only" id={main ? "send" : undefined} data-send-panel={main ? "main" : ""} data-location={location}>
  <a class="btn send-main" href={email} data-send="main">
    <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
      <path d="M1.5 1.5h15v9h-15zM0 12.5h18" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
    </svg>
    Send to my Mac
  </a>
  <div class="send-more">
    <button type="button" class="send-link" data-send="share" hidden>Share</button>
    <button type="button" class="send-link" data-send="copy"><span data-copy-label aria-live="polite">Copy link</span></button>
    <a class="send-link" href={email} data-send="email">Email it to me</a>
  </div>
</div>

<style>
  .send {
    margin-top: 26px;
    scroll-margin-top: 84px;
  }
  .send-main {
    width: 100%;
    justify-content: center;
  }
  .send-more {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 24px;
    margin-top: 6px;
  }
  .send-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--t-small);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    cursor: pointer;
    touch-action: manipulation;
  }
  .send-link[hidden] {
    display: none;
  }
  .send[data-flash] .send-main {
    animation: flash 900ms var(--ease-out);
  }
  @keyframes flash {
    30% {
      transform: scale(1.03);
    }
  }
</style>
