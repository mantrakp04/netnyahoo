+CefRefPtr<ChromeBrowserHostImpl> ChromeBrowserDelegate::DuplicateTab(
+    content::WebContents* source,
+    CefRefPtr<CefClient> client,
+    const CefBrowserSettings& settings,
+    CefRefPtr<CefDictionaryValue> extra_info) {
+  CEF_REQUIRE_UIT();
+  DCHECK(native_contents_hosting_);
+  auto* model = browser_->tab_strip_model();
+  const int index = model->GetIndexOfWebContents(source);
+  if (index == TabStripModel::kNoTab || pending_tab_) {
+    return nullptr;
+  }
+
+  // chrome::DuplicateTabAt, except that the copy opens in the background (the
+  // client decides when to show it).
+  std::unique_ptr<content::WebContents> copy = source->Clone();
+  content::WebContents* raw_copy = copy.get();
+  pending_tab_ = PendingTab{client, settings, extra_info};
+  model->InsertWebContentsAt(index + 1, std::move(copy),
+                             AddTabTypes::ADD_INHERIT_OPENER,
+                             model->GetTabGroupForTab(index));
+  pending_tab_.reset();
+  return ChromeBrowserHostImpl::GetBrowserForContents(raw_copy);
+}
