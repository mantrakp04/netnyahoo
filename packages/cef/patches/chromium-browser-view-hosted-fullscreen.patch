+// Tab fullscreen state of a Browser whose tabs the embedder hosts in its own
+// views (views::NativeHostedContents): the embedder shows fullscreen in its
+// own window, so this one never changes and only the state is tracked.
+DEFINE_UI_CLASS_PROPERTY_KEY(bool, kNativeHostedFullscreenKey, false)
+
 namespace {
 
 // The visible height of the shadow above the tabs. Clicks in this area are
 // treated as clicks to the frame, rather than clicks to the tab.
 const int kTabShadowSize = 2;
+
+bool HostsTabsNatively(BrowserWindowInterface* browser) {
+  const content::WebContents* contents =
+      browser ? browser->GetTabStripModel()->GetActiveWebContents() : nullptr;
+  return contents && views::NativeHostedContents::IsMarked(contents);
+}
 
