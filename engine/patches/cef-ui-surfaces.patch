+///
+/*--cef(added=experimental)--*/
+CefRefPtr<CefDictionaryValue> CefGetExtensionActionState(
+    CefRefPtr<CefBrowser> browser,
+    const CefString& extension_id);
+
+///
+/// Chrome style only. Returns the URL of the side panel the extension
+/// |extension_id| has for |browser|'s tab (chrome.sidePanel options: the
+/// tab's own path, else the default), or an empty string if it has none or it
+/// is disabled for the tab.
+///
+/*--cef(added=experimental)--*/
+CefString CefGetExtensionSidePanel(CefRefPtr<CefBrowser> browser,
+                                   const CefString& extension_id);
+
+///
+/// Chrome style only. Shows the Cast dialog for |browser|'s tab (see
+/// CefChromeUIHandler::OnCastDialog). Returns false if the Media Router is
+/// unavailable for its profile.
+///
+/*--cef(added=experimental)--*/
+bool CefShowCastDialog(CefRefPtr<CefBrowser> browser);
+
+///
+/// Switches the tab capture that |capturer| is running (a getUserMedia
+/// desktop capture of a tab, see CefGetMediaCaptureSourceId) to the tab
+/// |source_id|, as Chrome's "Share this tab instead" does: the page's tracks
+/// keep running with the new tab's video (and audio). The new source needs
+/// the client's permission again (CefPermissionHandler). Returns false if
+/// |capturer| isn't capturing a tab.
+///
+/*--cef(added=experimental)--*/
+bool CefChangeMediaCaptureSource(CefRefPtr<CefBrowser> capturer,
+                                 const CefString& source_id);
+
+///
+/// Returns the source id (see CefGetMediaCaptureSourceId) of the tab that
+/// |capturer| is capturing and could switch, or an empty string.
+///
+/*--cef(added=experimental)--*/
+CefString CefGetMediaCaptureTarget(CefRefPtr<CefBrowser> capturer);
+
+///
+/// Stops the screen, window and tab captures |capturer| is running, as
+/// Chrome's "Stop sharing" does (the page's tracks end). Returns false if it
