+void ShowInfoDialog(gfx::NativeWindow parent,
+                    const extensions::ExtensionId& extension_id,
+                    std::unique_ptr<ui::DialogModel> dialog_model) {
+  ExtensionsContainerViews* const container =
+      parent ? GetExtensionsContainerViews(parent) : nullptr;
+  views::Widget* const parent_widget =
+      parent ? views::Widget::GetWidgetForNativeWindow(parent) : nullptr;
+  if ((container && container->IsVisible()) || !parent_widget) {
+    ShowDialog(parent, extension_id, std::move(dialog_model));
+    return;
+  }
+
+  // Where Chrome's toolbar would put it, under the window's top-right corner.
+  // The anchor doesn't follow the window, but moving or resizing the window
+  // clicks it, which closes the bubble.
+  constexpr int kInset = 12;
+  const gfx::Rect client = parent_widget->GetClientAreaBoundsInScreen();
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(dialog_model), views::BubbleAnchor(),
+      views::BubbleBorder::TOP_RIGHT);
+  bubble->set_parent_window(parent_widget->GetNativeView());
+  bubble->SetAnchorRect(
+      gfx::Rect(client.right() - kInset, client.y() + kInset, 0, 0));
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+}
