+void RenderWidgetHostNSViewBridge::EnableDisplay() {
+  if (!display_disabled_)
+    return;
+  display_disabled_ = false;
+  ScopedCAActionDisabler disabler;
+  display_ca_layer_tree_ =
+      std::make_unique<ui::DisplayCALayerTree>(background_layer_);
+  // The tree's (autoresizing) layer starts empty and only follows later
+  // resizes, unlike at construction, when this view had no size yet.
+  background_layer_.sublayers.lastObject.frame = background_layer_.bounds;
 }
 
