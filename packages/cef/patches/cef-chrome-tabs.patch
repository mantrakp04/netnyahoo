+CefRefPtr<CefDictionaryValue> ChromeBrowserHostImpl::GetPasswordPrompt() {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return nullptr;
+  }
+  auto* web_contents = GetWebContents();
+  base::WeakPtr<PasswordsModelDelegate> delegate =
+      web_contents ? PasswordsModelDelegateFromWebContents(web_contents)
+                   : nullptr;
+  if (!delegate ||
+      delegate->GetState() == password_manager::ui::INACTIVE_STATE) {
+    return nullptr;
+  }
+
+  auto dict = CefDictionaryValue::Create();
+  const auto state = delegate->GetState();
+  dict->SetInt("state", static_cast<int>(state));
+  dict->SetString("origin", delegate->GetOrigin().Serialize());
+  if (state == password_manager::ui::PENDING_PASSWORD_STATE ||
+      state == password_manager::ui::PENDING_PASSWORD_UPDATE_STATE ||
+      state == password_manager::ui::SAVE_CONFIRMATION_STATE ||
+      state == password_manager::ui::AUTO_SIGNIN_STATE) {
+    const auto& form = delegate->GetPendingPassword();
+    dict->SetString("username", form.username_value);
+    dict->SetInt("passwordLength", static_cast<int>(form.password_value.size()));
+    dict->SetString("federation", form.federation_origin.IsValid()
+                                      ? form.federation_origin.Serialize()
+                                      : std::string());
+  }
+  auto usernames = CefListValue::Create();
+  for (const auto& form : delegate->GetCurrentForms()) {
+    if (form && !form->username_value.empty()) {
+      usernames->SetString(usernames->GetSize(), form->username_value);
+    }
+  }
+  dict->SetList("usernames", usernames);
+  return dict;
+}
+
+namespace cef {
+
+bool HandlePasswordBubble(content::WebContents* web_contents) {
+  auto browser = ChromeBrowserHostImpl::GetBrowserForContents(web_contents);
+  auto client = browser ? browser->GetClient() : nullptr;
+  auto handler = client ? client->GetCommandHandler() : nullptr;
+  if (!handler || !handler->OnChromeCommand(browser.get(),
+                                            IDC_MANAGE_PASSWORDS_FOR_PAGE,
+                                            CEF_WOD_CURRENT_TAB)) {
+    return false;
+  }
+  // What Chrome's bubble would report once shown; ResolvePasswordPrompt
+  // reports it hidden again.
+  if (auto delegate = PasswordsModelDelegateFromWebContents(web_contents)) {
+    delegate->OnBubbleShown();
+  }
+  return true;
+}
+
+}  // namespace cef
+
+void ChromeBrowserHostImpl::ResolvePasswordPrompt(const CefString& action,
+                                                  const CefString& username,
+                                                  const CefString& password) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return;
+  }
+  auto* web_contents = GetWebContents();
+  base::WeakPtr<PasswordsModelDelegate> delegate =
+      web_contents ? PasswordsModelDelegateFromWebContents(web_contents)
+                   : nullptr;
+  if (!delegate) {
+    return;
+  }
+
+  const std::string what = action.ToString();
+  if (what == "save" || what == "update") {
+    const auto& pending = delegate->GetPendingPassword();
+    delegate->SavePassword(
+        username.empty() ? pending.username_value : username.ToString16(),
+        password.empty() ? pending.password_value
+                         : password_manager::PasswordString(
+                               password.ToString16()));
+  } else if (what == "never") {
+    delegate->NeverSavePassword();
+  } else if (what == "nope") {
+    delegate->OnNopeUpdateClicked();
+  } else if (what != "dismiss") {
+    return;
+  }
+  // Like closing Chrome's bubble after any of these (it may have been
+  // destroyed by the action).
+  if (delegate) {
+    delegate->OnBubbleHidden();
+  }
+}
+
+CefRefPtr<ChromeBrowserHostImpl> ChromeBrowserHostImpl::CreateTabInBrowser(
+    CefRefPtr<CefClient> client,
+    const CefString& url,
+    const CefBrowserSettings& settings,
+    CefRefPtr<CefDictionaryValue> extra_info,
+    bool foreground) {
+  CEF_REQUIRE_UIT();
+  if (!browser_ || !browser_->cef_delegate()) {
+    return nullptr;
+  }
+  auto* delegate = static_cast<ChromeBrowserDelegate*>(browser_->cef_delegate());
+  if (!delegate->native_contents_hosting()) {
+    LOG(ERROR) << "CreateTabInBrowser requires a browser created with "
+                  "native_contents_hosting";
+    return nullptr;
+  }
+  return delegate->CreateTab(client, url_util::MakeGURL(url, /*fixup=*/true),
+                             settings, extra_info, foreground);
+}
