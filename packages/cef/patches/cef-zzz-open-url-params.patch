+namespace {
+
+// CEF_NN_OPEN_URL_PARAMS: the full parameters (post body, referrer, initiator)
+// of navigations Chrome asks to open in a new tab or window, kept for the
+// client to load into the browser it opens for them. UI thread only.
+struct OpenedURL {
+  content::OpenURLParams params;
+  size_t bytes = 0;
+};
+
+// A tab opened behind may load only when first shown, so entries stay until
+// used or forgotten. Past these bounds the oldest go, those without a body
+// first (the client loads one with a body at once, so it's rarely waiting).
+constexpr size_t kMaxOpenedURLs = 200;
+constexpr size_t kMaxOpenedURLBytes = 64 * 1024 * 1024;
+size_t g_opened_url_bytes = 0;
+
+size_t SizeOf(const content::OpenURLParams& params) {
+  size_t bytes = params.url.spec().size() + params.referrer.url.spec().size() +
+                 params.extra_headers.size();
+  if (params.post_data) {
+    for (const auto& element : *params.post_data->elements()) {
+      if (element.type() == network::DataElement::Tag::kBytes) {
+        bytes += element.As<network::DataElementBytes>().bytes().size();
+      }
+    }
+  }
+  return bytes;
+}
+
+std::map<int, OpenedURL>& OpenedURLs() {
+  static base::NoDestructor<std::map<int, OpenedURL>> urls;
+  return *urls;
+}
+
+int g_next_opened_url = 0;
+int g_current_opened_url = 0;
+
+void EraseOpenedURL(std::map<int, OpenedURL>::iterator it) {
+  g_opened_url_bytes -= it->second.bytes;
+  OpenedURLs().erase(it);
+}
+
+// Room for |incoming| more bytes.
+void ForgetStaleOpenedURLs(size_t incoming) {
+  auto& urls = OpenedURLs();
+  auto over = [&] {
+    return urls.size() >= kMaxOpenedURLs ||
+           g_opened_url_bytes + incoming > kMaxOpenedURLBytes;
+  };
+  for (auto it = urls.begin(); over() && it != urls.end();) {
+    auto next = std::next(it);
+    if (!it->second.params.post_data) {
+      EraseOpenedURL(it);
+    }
+    it = next;
+  }
+  while (over() && !urls.empty()) {
+    EraseOpenedURL(urls.begin());
+  }
+}
+
+bool KeepsOpenedURL(WindowOpenDisposition disposition) {
+  return disposition == WindowOpenDisposition::NEW_FOREGROUND_TAB ||
+         disposition == WindowOpenDisposition::NEW_BACKGROUND_TAB ||
+         disposition == WindowOpenDisposition::NEW_WINDOW ||
+         disposition == WindowOpenDisposition::NEW_SPLIT_VIEW;
+}
+
+}  // namespace
+
+extern "C" CEF_EXPORT int cef_nn_open_url_id() {
+  return CEF_CURRENTLY_ON_UIT() ? g_current_opened_url : 0;
+}
+
+extern "C" CEF_EXPORT void cef_nn_forget_open_url(int id) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    return;
+  }
+  auto it = OpenedURLs().find(id);
+  if (it != OpenedURLs().end()) {
+    EraseOpenedURL(it);
+  }
+}
+
+extern "C" CEF_EXPORT int cef_nn_open_url_has_body(int id) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    return 0;
+  }
+  auto it = OpenedURLs().find(id);
+  return it != OpenedURLs().end() && it->second.params.post_data ? 1 : 0;
+}
+
+extern "C" CEF_EXPORT int cef_nn_load_open_url(int browser_id, int id) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    return 0;
+  }
+  auto it = OpenedURLs().find(id);
+  if (it == OpenedURLs().end()) {
+    return 0;
+  }
+  auto browser = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  content::WebContents* web_contents =
+      browser ? browser->GetWebContents() : nullptr;
+  if (!web_contents) {
+    EraseOpenedURL(it);
+    return 0;
+  }
+  // Only into the profile the navigation came from: its source SiteInstance
+  // belongs to that BrowserContext.
+  const auto& source = it->second.params.source_site_instance;
+  if (source && source->GetBrowserContext() != web_contents->GetBrowserContext()) {
+    EraseOpenedURL(it);
+    return 0;
+  }
+  content::NavigationController::LoadURLParams load(it->second.params);
+  EraseOpenedURL(it);
+  // A new browser starts on about:blank: the page takes that entry. In a
+  // browser with a page (a split's pane), it's a new entry.
+  const content::NavigationEntry* current =
+      web_contents->GetController().GetLastCommittedEntry();
+  load.should_replace_current_entry =
+      web_contents->GetController().GetEntryCount() <= 1 &&
+      (!current || current->GetURL().IsAboutBlank() ||
+       current->GetURL().is_empty());
+  web_contents->GetController().LoadURLWithParams(load);
+  return 1;
+}
