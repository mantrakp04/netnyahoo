{
  "name": "@arcadia/browser",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "react-native start",
    "macos": "xcodebuild -workspace macos/Arcadia.xcworkspace -scheme Arcadia-macOS -derivedDataPath build -destination 'platform=macOS,arch=arm64' -quiet -configuration Debug && open -n --env ARCADIA_DATA_DIR=\"${ARCADIA_DATA_DIR:-$HOME/Library/Application Support/Arcadia Dev}\" build/Build/Products/Debug/Arcadia.app",
    "pods": "cd macos && pod install",
    "build": "xcodebuild -workspace macos/Arcadia.xcworkspace -scheme Arcadia-macOS -derivedDataPath build -destination 'platform=macOS,arch=arm64' -quiet -configuration Release",
    "typecheck": "tsc -p .",
    "test": "node --no-warnings --import ./src/test-loader.mjs --test \"src/**/*.test.mjs\""
  },
  "dependencies": {
    "@arcadia/core": "workspace:*",
    "@arcadia/shaders": "workspace:*",
    "@arcadia/shell": "workspace:*",
    "@arcadia/arcadiacore": "workspace:*",
    "@arcadia/import": "workspace:*",
    "@arcadia/sync": "workspace:*",
    "expo": "~54.0.37",
    "expo-modules-core": "~3.0.29",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.9",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-apple": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
}
