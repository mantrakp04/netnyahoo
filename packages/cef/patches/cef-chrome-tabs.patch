@@ -0,0 +1,63 @@
+// Copyright (c) 2026 The Netnyahoo Authors. All rights reserved.
+//
+// Feature markers for Netnyahoo's CEF patches (see the Netnyahoo repository,
+// packages/cef/patches and docs/cef-source-build.md). Clients test for this
+// header with __has_include and for each marker with #ifdef, so they build
+// against stock CEF too. All of these APIs are CEF_API_ADDED(CEF_EXPERIMENTAL).
+
+#ifndef CEF_INCLUDE_CEF_NETNYAHOO_H_
+#define CEF_INCLUDE_CEF_NETNYAHOO_H_
+#pragma once
+
+// CefGetMediaCaptureSourceId (include/cef_media_capture.h); desktop audio of a
+// captured tab is that tab's audio.
+#define CEF_NN_TAB_CAPTURE 1
+
+// CefBrowserSettings.native_contents_hosting, CefBrowserHost::GetContentsView,
+// CefBrowserHost::CreateTabInBrowser, CefBrowserHost::SetWindowActive,
+// CefBrowserHost::ActivateTab, CefBrowserHost::MoveToBrowser.
+#define CEF_NN_CHROME_TABS 1
+
+// CefRequestContext::LoadComponentExtension / UnloadComponentExtension.
+#define CEF_NN_COMPONENT_EXTENSIONS 1
+
+// CefBrowserHost::GetTabId.
+#define CEF_NN_TAB_SESSION_ID 1
+
+// CefBrowserHost::ExecuteExtensionAction.
+#define CEF_NN_EXTENSION_ACTION 1
+
+// Tab fullscreen of natively hosted tabs leaves the (hidden) Chrome window
+// alone; the client gets CefDisplayHandler::OnFullscreenModeChange.
+#define CEF_NN_TAB_FULLSCREEN 1
+
+// CefBrowserHost::GetPasswordPrompt / ResolvePasswordPrompt.
+#define CEF_NN_PASSWORD_PROMPT 1
+
+// CefLifeSpanHandler::OnTabStripChanged, CefBrowserHost::SetTabIndex /
+// SetTabPinned.
+#define CEF_NN_TAB_STRIP 1
+
+// Popups allowed in OnBeforePopup from natively hosted tabs become background
+// tabs of the opener's Chrome window instead of new windows.
+#define CEF_NN_POPUP_TABS 1
+
+// Chrome's password bubble first offers the tab's client
+// IDC_MANAGE_PASSWORDS_FOR_PAGE (CefCommandHandler::OnChromeCommand); returning
+// true skips the bubble. ResolvePasswordPrompt closes the prompt either way.
+#define CEF_NN_PASSWORD_BUBBLE 1
+
+// CefRequestContextHandler::OnExtensionInstallPrompt replaces Chrome's
+// extension install dialog. Chrome Web Store installs work end to end (CRX
+// downloads stay out of CefDownloadHandler) and store extensions auto-update.
+#define CEF_NN_INSTALL_PROMPT 1
+
+// CefBrowserSettings.hidden_from_extensions.
+#define CEF_NN_HIDDEN_BROWSER 1
+
+// The Safe Storage key lives in its own "Netnyahoo Safe Storage" keychain
+// item; webauthn uses Netnyahoo's bundle/team id and the embedder's NSWindow
+// for iCloud Keychain passkeys.
+#define CEF_NN_SAFE_STORAGE 1
+
+#endif  // CEF_INCLUDE_CEF_NETNYAHOO_H_
