+CefRefPtr<CefBrowser> CefBrowserViewImpl::CreateTab(
+    CefRefPtr<CefClient> client,
+    const CefString& url,
+    const CefBrowserSettings& settings,
+    CefRefPtr<CefDictionaryValue> extra_info,
+    bool foreground) {
+  CEF_REQUIRE_VALID_RETURN(nullptr);
+  if (!CEF_MEMBER_EXISTS(&settings, chrome_zoom_bubble)) {
+    DCHECK(false) << "invalid CefBrowserSettings structure size";
+    return nullptr;
+  }
+  if (is_alloy_style_ || !root_view()) {
+    return nullptr;
+  }
+  BrowserWindowInterface* browser = chrome_browser_view()->browser();
+  if (!browser || !browser->cef_delegate() ||
+      UnloadController::From(browser)->is_attempting_to_close_browser()) {
+    return nullptr;
+  }
+  auto* delegate = static_cast<ChromeBrowserDelegate*>(browser->cef_delegate());
+  if (!delegate->client_window()) {
+    LOG(ERROR) << "CefBrowserView::CreateTab requires client_window";
+    return nullptr;
+  }
+  return delegate
+      ->CreateTab(client, url_util::MakeGURL(url, /*fixup=*/true), settings,
+                  extra_info, foreground)
+      .get();
+}
