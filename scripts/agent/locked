#!/bin/bash
# The shared locks agents take in this checkout (xcodebuild, pod install, the Chromium build).
#
#   scripts/agent/locked <name> [--wait SECS] [--as WHO] -- <command> [args…]   run one command holding it
#   scripts/agent/locked <name> --take WHO [--ttl MIN] [--wait SECS]              hold it across several calls
#   scripts/agent/locked <name> --release WHO                                   give back a --take
#   scripts/agent/locked -h | --help                                            this text
#
# <name> is xcodebuild, pod or chromium.
#   - xcodebuild is one lock per derived data: builds with different -derivedDataPath run in parallel (the Podfile and
#     the build phases keep each build's writes in its own folder); two into the same one take turns. A command
#     without -derivedDataPath (one run through `sh -c`, say) takes the single shared xcodebuild lock.
#     scripts/agent/build-app is the quiet way to build the app.
#   - pod covers pod install, pnpm install and edits to apps/browser/package.json; chromium covers ~/chromium-build.
#   - The Pods directory is a readers-writer lock between them: any number of xcodebuild commands read it at once,
#     a pod command rewrites it alone. A pod command waits for running builds to finish, and builds that start
#     meanwhile wait for it, so it isn't starved.
# The old pattern (`until mkdir /tmp/nn-<name>.lock; …; rmdir`)
# left the lock behind whenever the shell was killed before its rmdir (a tool timeout, ⌃C), and every
# other agent then waited forever. Here:
#   - everything runs under a kernel lock (lockf) that dies with its holder, and a command's pid is
#     recorded, so a holder that died is noticed and its lock removed;
#   - --take records WHO and an expiry (default 60 min); --as WHO runs the taker's own commands (one
#     at a time) and pushes the expiry back. An expired take counts as abandoned. Taking again what
#     WHO already holds just renews it;
#   - the old /tmp/nn-<name>.lock directory is still created while held, so agents on the mkdir
#     pattern keep waiting for us. One of theirs is never removed: we wait and say so.
# Nested calls: a command run under `locked <name>` may call `locked <name>` again (the app build runs
# packages/nncore/scripts/stage-framework.sh, which takes chromium). If an enclosing call already holds that
# lock, the inner command runs straight through. --as WHO is passed down too (NN_LOCKED_AS), so under
# `locked xcodebuild --as pip -- …` a nested `locked chromium` uses pip's take; export NN_LOCKED_AS=pip yourself
# for the same effect from a plain shell.
# Waiting gives up after --wait seconds (default 500, under the Bash tool's 600 s limit) with exit 75
# and names the holder. Run long builds with the Bash tool's run_in_background instead of waiting on
# them in the foreground. NN_LOCK_ROOT (default /tmp) moves the lock files, for testing this script only.
set -uo pipefail
# Set below as plain variables; never inherit them (an enclosing call once leaked on_start into its command).
unset on_start cmd

help() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
  exit 0
}
usage() {
  sed -n '4,7p' "$0" | sed 's/^# *//' >&2
  exit 64
}

name="${1:-}"
case "$name" in -h | --help) help ;; xcodebuild | pod | chromium) ;; *) usage ;; esac
shift
wait=500 as="" take="" release="" ttl=60
while [[ $# -gt 0 && "$1" != "--" ]]; do
  case "$1" in -h | --help) help ;; esac
  [[ $# -ge 2 ]] || { echo "locked: $1 needs a value" >&2; usage; }
  case "$1" in
    --wait) wait="$2" ;;
    --as) as="$2" ;;
    --take) take="$2" ;;
    --release) release="$2" ;;
    --ttl) ttl="$2" ;;
    *) echo "locked: unknown option $1" >&2; usage ;;
  esac
  shift 2
done
[[ "${1:-}" == "--" ]] && shift
[[ -n "$take$release" || $# -gt 0 ]] || usage
[[ "$wait$ttl" =~ ^[0-9]+$ ]] || { echo "locked: --wait and --ttl take whole numbers" >&2; usage; }
# A command's own --as wins; otherwise it acts as whoever an enclosing call ran as.
[[ -z "$as$take$release" ]] && as="${NN_LOCKED_AS:-}"

# xcodebuild locks the derived data its command names (see above).
lock=$name
if [[ $name == xcodebuild && $# -gt 0 && -z "$take$release" ]]; then
  dd="" prev=""
  for arg in "$@"; do
    [[ $prev == -derivedDataPath ]] && dd=$arg
    prev=$arg
  done
  if [[ -n "$dd" ]]; then
    # One name per directory, however it's spelled (relative, /tmp vs /private/tmp, a trailing slash).
    dd=${dd%/}
    [[ "$dd" == /* ]] || dd="$PWD/$dd"
    if [[ -d "$dd" ]]; then
      dd=$(cd "$dd" && pwd -P)
    elif [[ -d "${dd%/*}" ]]; then
      dd="$(cd "${dd%/*}" && pwd -P)/${dd##*/}"
    fi
    lock="xcodebuild-$(printf %s "${dd##*/}" | tr -c 'A-Za-z0-9_.-' _ | cut -c1-40)-$(printf %s "$dd" | shasum | cut -c1-8)"
  fi
fi

root=${NN_LOCK_ROOT:-/tmp}
kernel=$root/nn-$lock.lockf
legacy=$root/nn-$lock.lock
holder=$root/nn-$lock.holder
now() { date +%s; }

# Holder file: "pid <pid> <description>" or "take <expiry epoch> <who> <description>".
field() { awk -v n="$1" '{print $n; exit}' "$holder" 2>/dev/null; }
taken_by() { [[ "$(field 1)" == take && "$(field 3)" == "$1" ]]; }
renew() { sed -i '' "1s/^take [0-9]*/take $(($(now) + ttl * 60))/" "$holder"; }

describe() {
  if [[ "$(field 1)" == take ]]; then
    echo "taken by $(cut -d' ' -f3- "$holder"), until $(date -r "$(field 2)" '+%H:%M:%S') (if that take is yours, pass --as $(field 3), or export NN_LOCKED_AS=$(field 3) so nested calls use it)"
  elif [[ -s "$holder" ]]; then
    echo "held by pid $(cut -d' ' -f2- "$holder")"
  elif [[ -d "$legacy" ]]; then
    echo "held since $(stat -f %Sm "$legacy") by an agent using the old mkdir lock; if nothing is building, the owner can rmdir $legacy"
  fi
}

# NN_LOCKED_HELD lists the locks enclosing calls hold for this process tree, one "<pid> <kernel lock path>" a line,
# the pid being the call that holds it (alive exactly as long as it does).
held_by_caller() {
  local pid path want=${1:-$kernel}
  while read -r pid path; do
    [[ -n "$pid" && "$path" == "$want" ]] && kill -0 "$pid" 2>/dev/null && { echo "$pid"; return 0; }
  done <<<"${NN_LOCKED_HELD:-}"
  return 1
}

# The Pods readers-writer lock (see above): runs a command holding flock(2) on $root/nn-pods.rw, shared (SH) or
# exclusive (EX), giving up after a timeout with exit 76 (reported as 75). perl holds the lock itself, so nothing
# the command starts (Xcode's build service) can keep it.
rw_perl='
use Fcntl qw(:flock);
my ($mode, $path, $timeout, @cmd) = @ARGV;
open(my $fh, ">>", $path) or die "locked: cannot open $path: $!\n";
my $deadline = time + ($timeout > 0 ? $timeout : 1);
my $said = 0;
until (flock($fh, ($mode eq "EX" ? LOCK_EX : LOCK_SH) | LOCK_NB)) {
  if (time >= $deadline) {
    print STDERR $mode eq "EX"
      ? "locked: app builds still read the Pods after ${timeout}s; run this again once they finish\n"
      : "locked: a pod install still rewrites the Pods after ${timeout}s\n";
    exit 76;
  }
  print STDERR $mode eq "EX" ? "locked: waiting for running app builds to finish (they read the Pods)\n"
    : "locked: waiting for a pod install to finish\n" unless $said++;
  sleep 2;
}
my $pid = fork;
defined $pid or die "locked: fork: $!\n";
if (!$pid) { close $fh; exec { $cmd[0] } @cmd; die "locked: cannot run $cmd[0]: $!\n"; }
for my $sig (qw(INT TERM HUP)) { $SIG{$sig} = sub { kill $sig, $pid }; }
waitpid($pid, 0);
exit(($? & 127) ? 128 + ($? & 127) : $? >> 8);
'

# Runs the command as a child so its pid can be recorded, and passes signals on to it. The child learns which
# locks it now holds and as whom, so its own nested calls go straight through.
run() {
  NN_LOCKED_HELD="${NN_LOCKED_HELD:+$NN_LOCKED_HELD
}$$ $kernel" NN_LOCKED_AS="$as" "$@" &
  child=$!
  trap 'kill -INT "$child" 2>/dev/null; wait "$child"; exit 130' INT
  trap 'kill -TERM "$child" 2>/dev/null; wait "$child"; exit 143' TERM
  trap 'kill -HUP "$child" 2>/dev/null; wait "$child"; exit 129' HUP
  "${on_start:-true}" "$child"
  wait "$child"
}

# The inner run is always lockf's own child. A command started by an older copy of this script inherited
# NN_LOCKED_INNER; ignore it there, so its nested calls take the lock properly.
if [[ -n "${NN_LOCKED_INNER:-}" && "$(ps -o comm= -p "$PPID" 2>/dev/null)" != *lockf ]]; then
  unset NN_LOCKED_INNER NN_LOCKED_DEADLINE
fi

if [[ -z "${NN_LOCKED_INNER:-}" ]]; then
  if outer=$(held_by_caller); then
    if [[ -n "$take$release" ]]; then
      echo "locked: $name is held by an enclosing call (pid $outer) of this command; --take/--release it outside that call" >&2
      exit 64
    fi
    echo "locked: $name is already held by an enclosing call (pid $outer); running inside it" >&2
    exec "$@"
  fi
  start=$(now)
  deadline=$((start + wait))
  # A build never starts while a pod install rewrites the Pods project (taking the pod lock and letting it go at
  # once). One already holding it (scripts/release.sh) runs straight through.
  if [[ $name == xcodebuild && -z "$take$release" ]]; then
    NN_LOCKED_NO_RW=1 "$0" pod --wait "$wait" -- true 2>/dev/null || {
      echo "locked: a pod install still holds the pod lock after ${wait}s; see $root/nn-pod.holder" >&2
      exit 75
    }
  fi
  opts=(--wait "$wait" --ttl "$ttl")
  [[ -n "$take" ]] && opts+=(--take "$take")
  [[ -n "$as" ]] && opts+=(--as "$as")
  [[ -n "$release" ]] && opts+=(--release "$release")
  # The kernel lock only guards the holder bookkeeping and the command itself. A caller waiting for someone
  # else's hold waits out here, between attempts, so it never blocks the holder's own --as commands (it once
  # did: a waiter sat inside the kernel lock and the taker's next build waited its full 500 s).
  while :; do
    left=$((deadline - $(now)))
    ((left < 1)) && left=1
    NN_LOCKED_INNER=1 NN_LOCKED_DEADLINE=$deadline lockf -s -k -t "$left" "$kernel" "$0" "$name" "${opts[@]}" -- "$@"
    status=$?
    # 77: busy (held by someone else); try again until the deadline.
    if [[ $status -eq 77 && $(now) -lt $deadline ]]; then
      sleep 3
      continue
    fi
    break
  done
  # 76: the inner run gave up and already said why; 77: still busy at the deadline; 75 from lockf itself: its own
  # wait ran out.
  # A build registers its Netnyahoo.app with LaunchServices under the real bundle id; take it back out so
  # macOS never opens a test build as the owner's browser (unregister-builds says why).
  if [[ $name == xcodebuild && -z "$take$release" ]]; then
    "$(dirname "$0")/unregister-builds" >/dev/null 2>&1 &
  fi
  [[ $status -eq 77 ]] && echo "locked: $name lock still busy after ${wait}s; $(describe)" >&2
  [[ $status -eq 76 || $status -eq 77 ]] && exit 75
  if [[ $status -eq 75 && $(($(now) - start)) -ge $wait ]]; then
    echo "locked: $name lock still busy after ${wait}s; $(describe)" >&2
  fi
  exit $status
fi

# Inside the kernel lock: no other caller of this script is in this part at the same time, so the
# holder file can't change under us. The two variables only tell this inner run where it is; the command must
# not inherit them, or its own nested calls would skip the kernel lock and exit 77 with nothing said.
deadline=${NN_LOCKED_DEADLINE:-$(($(now) + wait))}
unset NN_LOCKED_INNER NN_LOCKED_DEADLINE

# The command, behind the Pods readers-writer lock when it's a build or a pod command (NN_LOCKED_NO_RW: the
# pre-build check above, which only waits for the pod lock). A build under an enclosing pod call already has it.
rw=()
if [[ -z "${NN_LOCKED_NO_RW:-}" && $# -gt 0 ]]; then
  case $name in
    pod) rw=(perl -e "$rw_perl" EX "$root/nn-pods.rw") ;;
    xcodebuild) held_by_caller "$root/nn-pod.lockf" >/dev/null || rw=(perl -e "$rw_perl" SH "$root/nn-pods.rw") ;;
  esac
fi
unset NN_LOCKED_NO_RW
rw_timeout() { local left=$((deadline - $(now))); ((left < 1)) && left=1; echo "$left"; }

if [[ -n "$release" ]]; then
  if taken_by "$release"; then
    rm -f "$holder"
    rmdir "$legacy" 2>/dev/null
    echo "locked: released $name" >&2
    exit 0
  fi
  echo "locked: $name isn't taken by $release; $(describe)" >&2
  exit 1
fi

if [[ -n "$take" ]] && taken_by "$take"; then
  renew
  echo "locked: $name already taken by $take; renewed for ${ttl} min" >&2
  exit 0
fi

if [[ -n "$as" ]] && taken_by "$as"; then
  renew
  if [[ ${#rw[@]} -gt 0 ]]; then set -- "${rw[@]}" "$(rw_timeout)" "$@"; fi
  run "$@"
  status=$?
  taken_by "$as" && renew
  exit $status
fi

while ! mkdir "$legacy" 2>/dev/null; do
  stale=""
  case "$(field 1)" in
    pid)
      pid=$(field 2)
      kill -0 "$pid" 2>/dev/null || stale="its holder (pid $pid) has exited"
      ;;
    take)
      [[ $(now) -gt $(field 2) ]] && stale="$(field 3)'s take expired"
      ;;
  esac
  if [[ -n "$stale" ]]; then
    echo "locked: removing stale $legacy: $stale" >&2
    rm -f "$holder"
    rm -rf "$legacy"
    continue
  fi
  if [[ $(now) -ge $deadline ]]; then
    echo "locked: $name lock still busy after ${wait}s; $(describe)" >&2
    exit 76
  fi
  # Busy: leave the kernel lock and let the outer loop try again (see above).
  exit 77
done
# A holder file left beside a directory we just created belongs to nobody.
rm -f "$holder"

if [[ -n "$take" ]]; then
  echo "take $(($(now) + ttl * 60)) $take since $(date '+%H:%M:%S')" >"$holder"
  echo "locked: $name taken by $take for ${ttl} min; run its commands with --as $take, then --release $take" >&2
  exit 0
fi

cleanup() {
  rm -f "$holder"
  rmdir "$legacy" 2>/dev/null
}
trap cleanup EXIT
record() { echo "pid $1 since $(date '+%H:%M:%S') in $PWD: ${cmd}" >"$holder"; }
cmd="$*"
on_start=record
if [[ ${#rw[@]} -gt 0 ]]; then set -- "${rw[@]}" "$(rw_timeout)" "$@"; fi
run "$@"
