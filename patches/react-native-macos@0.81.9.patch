+// [Netnyahoo: the layer transform for transform3D at the view's current size. On macOS, layer.anchorPoint is
+// {0, 0} instead of {0.5, 0.5} as on iOS, so the transform is moved to apply from the view's center; that depends
+// on the size, so it's worked out again each time it's applied.
+static CATransform3D RCTUIViewLayerTransform(RCTUIView *view)
+{
+  CATransform3D transform = view->_transform3D;
+  if (CGPointEqualToPoint(view.layer.anchorPoint, CGPointZero) && view->_hasCustomTransform3D) {
+    CATransform3D originAdjust = CATransform3DMakeTranslation(view.bounds.size.width / 2, view.bounds.size.height / 2, 0);
+    transform = CATransform3DConcat(CATransform3DConcat(CATransform3DInvert(originAdjust), transform), originAdjust);
+  }
+  return transform;
+}
+
+// AppKit owns a layer-backed view's geometry: it puts the layer's transform back to identity whenever the frame
+// changes (setFrameOrigin:/setFrameSize:, which don't always lead to updateLayer) and when the view joins a layer
+// tree (before updateLayer). Each of those writes the stored transform back.
+static void RCTUIViewApplyTransform3D(RCTUIView *view)
 {
-  // On macOS, layer.anchorPoint defaults to {0, 0} instead of {0.5, 0.5} on iOS.
