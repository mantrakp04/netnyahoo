+CefRefPtr<ChromeBrowserHostImpl> ChromeBrowserDelegate::RestoreTab(
+    const std::vector<sessions::SerializedNavigationEntry>& navigations,
+    int selected_navigation,
+    CefRefPtr<CefClient> client,
+    const CefBrowserSettings& settings,
+    CefRefPtr<CefDictionaryValue> extra_info) {
+  CEF_REQUIRE_UIT();
+  DCHECK(native_contents_hosting_);
+  if (navigations.empty() || pending_tab_) {
+    return nullptr;
+  }
+
+  // Chrome's own path for reopening a closed tab (TabRestoreService), in the
+  // background: it loads its current entry once the client shows it.
+  pending_tab_ = PendingTab{client, settings, extra_info};
+  content::WebContents* web_contents = chrome::AddRestoredTab(
+      browser_.get(), navigations, browser_->tab_strip_model()->count(),
+      selected_navigation, /*extension_app_id=*/std::string(),
+      /*group=*/std::nullopt, /*select=*/false, /*pin=*/false,
+      base::TimeTicks::Now(), base::Time::Now(),
+      /*storage_namespace=*/nullptr, sessions::SerializedUserAgentOverride(),
+      /*extra_data=*/{}, /*from_session_restore=*/false,
+      /*is_active_browser=*/std::nullopt);
+  pending_tab_.reset();
+  return web_contents
+             ? ChromeBrowserHostImpl::GetBrowserForContents(web_contents)
+             : nullptr;
