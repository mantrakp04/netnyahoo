+bool ChromeBrowserHostImpl::MoveToBrowser(CefRefPtr<CefBrowser> target,
+                                          int index,
+                                          bool foreground) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+
+  auto target_base = CefBrowserHostBase::FromBrowser(target);
+  if (!target_base || !target_base->IsChromeStyle() || !browser_ ||
+      !GetWebContents()) {
+    return false;
+  }
+  Browser* target_browser = FromBaseChecked(target_base)->browser();
+  if (!target_browser || target_browser == browser_) {
+    return false;
+  }
+
+  auto* from_model = browser_->tab_strip_model();
+  const int from_index = from_model->GetIndexOfWebContents(GetWebContents());
+  if (from_index == TabStripModel::kNoTab) {
+    return false;
+  }
+
+  // Same as dragging a tab between windows: the tab (and this browser host)
+  // survives; the target Browser's delegate re-associates it in
+  // SetAsDelegate().
+  std::unique_ptr<tabs::TabModel> tab =
+      from_model->DetachTabAtForInsertion(from_index);
+  auto* to_model = target_browser->tab_strip_model();
+  const int to_index =
+      (index < 0 || index > to_model->count()) ? to_model->count() : index;
+  to_model->InsertDetachedTabAt(
+      to_index, std::move(tab),
+      foreground ? AddTabTypes::ADD_ACTIVE : AddTabTypes::ADD_NONE);
+  return true;
+}
