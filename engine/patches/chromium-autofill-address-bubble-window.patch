 namespace {
 
+// Netnyahoo: FindBrowserWindowWithWebContents finds a BrowserView only; a Browser
+// without one (NNCore's) has its own BrowserWindow, which shows the bubbles.
+BrowserWindow* FindBubbleWindow(content::WebContents* web_contents) {
+  if (BrowserWindow* window =
+          BrowserWindow::FindBrowserWindowWithWebContents(web_contents)) {
+    return window;
+  }
+  return BrowserWindow::FromBrowser(
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(web_contents));
+}
