{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "netnyahoo",
  "title": "Netnyahoo",
  "description": "Search and switch your open Netnyahoo tabs",
  "icon": "icon.png",
  "author": "mantrakp04",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-tabs",
      "title": "Search Tabs",
      "subtitle": "Netnyahoo",
      "description": "Search your open tabs in Netnyahoo and switch to one",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "test": "node --test src/scripts.test.ts"
  }
}
