+void CefMediaStreamRegistrar::UnregisterMediaStream(const std::string& label,
+                                                    int ui_id) {
+  CEF_REQUIRE_UIT();
+  auto it = registered_streams_.find(label);
+  if (it == registered_streams_.end() || it->second.ui_id != ui_id) {
+    return;
+  }
+  if (changing_.count(label)) {
+    // Switching sources: the new UI registers the stream again, so keep
+    // reporting it (no capture-ended blip) unless that never happens.
+    it->second.ui_id = 0;
+    CEF_POST_DELAYED_TASK(
+        CEF_UIT,
+        base::BindOnce(&CefMediaStreamRegistrar::DropReplacedStream,
+                       weak_ptr_factory_.GetWeakPtr(), label),
+        5000);
+    return;
+  }
+  registered_streams_.erase(it);
   NotifyMediaStreamChange();
