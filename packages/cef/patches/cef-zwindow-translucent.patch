--- a/include/views/cef_window_delegate.h
+++ b/include/views/cef_window_delegate.h
@@ -155,6 +155,15 @@
   virtual bool IsFrameless(CefRefPtr<CefWindow> window) { return false; }
 
   ///
+  /// Return true if |window| should be created translucent: its native window
+  /// isn't opaque and its compositor clears to transparent, so wherever the
+  /// window's views (and its background color, see CefView::SetBackgroundColor)
+  /// draw nothing, what is behind the window shows. Only supported on macOS.
+  ///
+  /*--cef(added=experimental)--*/
+  virtual bool IsTranslucent(CefRefPtr<CefWindow> window) { return false; }
+
+  ///
   /// Return true if |window| should be created with standard window buttons
