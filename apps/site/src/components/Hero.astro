---
import { Image } from "astro:assets";
import poster from "../assets/yahu-poster.webp";
import DownloadButton from "./DownloadButton.astro";
import { REPO, VERSION } from "../data/release";
---

<section class="hero" id="top" data-shot="hero">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <h1 class="poster hero-title">
        <span class="line"><span>Full</span></span>{" "}
        <span class="line"><span>immunity.</span></span>
      </h1>
      <p class="lede" data-reveal style="--i: 2">
        Real Chromium for the Mac. Immune to ads, trackers and prosecution.
      </p>
      <div class="cta-row" data-reveal style="--i: 3">
        <DownloadButton />
        <a class="link source" href={REPO} rel="noopener">Read the source</a>
      </div>
      <p class="label fine" data-reveal style="--i: 4">
        <span>v{VERSION}</span><span>Free</span><span>macOS 14+</span><span>Apple Silicon</span><span>Notarized</span>
      </p>
    </div>

    <figure class="hero-figure">
      <div class="stage" data-stage="hero">
        <Image
          class="stage-poster"
          src={poster}
          alt="Big Yahu, the Netnyahoo mascot: a glossy toy caricature of Benjamin Netanyahu in a dark suit and blue tie."
          widths={[400, 600, 800, 1120]}
          sizes="(max-width: 820px) 92vw, 560px"
          loading="eager"
          fetchpriority="high"
        />
        <p class="stamp" aria-hidden="true"><span>Incumbent</span></p>
      </div>
      <figcaption class="label stage-caption">
        <span>Fig. 1 — Big Yahu, candidate</span>
        <span class="hint">Drag to turn · click to dance</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(24px, 5vh, 72px);
    padding-bottom: clamp(48px, 8vh, 96px);
  }
  /* One text block (headline, lede, download, fine print) bottom-aligned with Big Yahu's caption,
     so the headline sits on the lede like a poster instead of floating above an empty row. */
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: end;
  }
  .hero-text {
    grid-column: 1 / span 7;
    grid-row: 1;
    position: relative;
    z-index: 3;
  }
  .hero-title {
    font-size: clamp(3.2rem, min(12.5vw, 22vh), 13rem);
    line-height: 0.85;
    margin-left: -0.045em;
    white-space: nowrap;
  }
  .line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
  }
  .line > span {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .line > span {
      animation: rise 1000ms var(--ease-out) both;
    }
    .js .line:nth-child(2) > span {
      animation-delay: 70ms;
    }
  }
  @keyframes rise {
    from {
      transform: translateY(100%);
    }
  }

  .lede {
    font-size: var(--t-lede);
    line-height: 1.36;
    max-width: 24em;
    margin-top: clamp(18px, 2.8vh, 30px);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: clamp(22px, 3.4vh, 34px);
  }
  .source {
    font-size: var(--t-small);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .fine {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin-top: 18px;
    color: var(--ink-3);
  }
  .fine span + span::before {
    content: "/";
    margin: 0 10px;
    color: var(--rule);
  }

  .hero-figure {
    grid-column: 8 / -1;
    grid-row: 1;
    justify-self: end;
    margin: 0;
    position: relative;
    z-index: 2;
    width: min(100%, 560px);
  }
  .stage {
    position: relative;
    aspect-ratio: 56 / 66;
    max-height: max(400px, 66svh);
    width: 100%;
    cursor: grab;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
  }
  .stage:active {
    cursor: grabbing;
  }
  .stage-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
    transition: opacity 400ms var(--ease-out) 100ms;
    pointer-events: none;
  }
  .stage[data-live] .stage-poster {
    opacity: 0;
  }
  .stage :global(.yahu-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }
  .stage[data-live] :global(.yahu-canvas) {
    opacity: 1;
  }
  .stamp {
    position: absolute;
    right: 2%;
    top: 16%;
    margin: 0;
    transform: rotate(-9deg);
    pointer-events: none;
    font-family: var(--poster);
    font-weight: 850;
    font-stretch: 75%;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-size: clamp(0.85rem, 0.7rem + 0.5vw, 1.2rem);
    color: var(--stamp);
    border: 2.5px solid currentColor;
    padding: 3px;
    border-radius: 4px;
    mix-blend-mode: multiply;
    opacity: 0.9;
  }
  .stamp span {
    display: block;
    border: 1px solid currentColor;
    padding: 5px 12px 4px;
    border-radius: 2px;
  }
  .stage-caption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--rule-strong);
    padding-top: 10px;
    color: var(--ink-2);
  }
  .hint {
    color: var(--ink-3);
  }

  @media (max-width: 1100px) {
    .hint {
      display: none;
    }
  }

  /* Phones and small tablets: the text block first, set as big as the width allows, then him. */
  @media (max-width: 820px) {
    .hero {
      padding-top: 20px;
      padding-bottom: 56px;
    }
    .hero-grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }
    .hero-title {
      /* "IMMUNITY." is ~3.95em wide: fill the column edge to edge. */
      font-size: min(calc((100vw - 2 * var(--gutter)) / 3.95), 11rem);
      line-height: 0.84;
    }
    .lede {
      margin-top: 18px;
      max-width: 22em;
    }
    .cta-row {
      margin-top: 24px;
      gap: 4px 24px;
    }
    .fine {
      margin-top: 10px;
      gap: 4px 18px;
    }
    /* Wrapped slashes read as typos on a phone; plain spacing wraps cleanly. */
    .fine span + span::before {
      content: none;
    }
    .hero-figure {
      width: 100%;
      margin-top: 8px;
    }
    .stage {
      aspect-ratio: 1 / 0.86;
      max-height: 62svh;
    }
    .stamp {
      right: 0;
      top: 10%;
    }
    .hint {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .cta-row :global(.btn) {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
