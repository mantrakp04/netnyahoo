# Copyright 2026 Netnyahoo. Apache-2.0.
#
# //chrome/browser/netnyahoo: Netnyahoo's own code in the Chromium tree. Plain
# Chromium code over Chrome's services, exported as plain C (public/nn_engine.h)
# and linked by both engines: CEF's libcef_static and NNCore's //chrome:chrome_dll
# (hooks in engine/chromium/apply.sh). The repo copy is engine/chromium/src;
# never edit the tree's copy.
#
# One source_set: add your nn_<domain>.{h,cc} to `sources` (sorted) and the
# deps it needs. Nothing in //chrome depends on this target.

assert(is_mac)

source_set("netnyahoo") {
  sources = [
    "nn_autofill.cc",
    "nn_autofill.h",
    "nn_bookmarks.cc",
    "nn_browsing_data.cc",
    "nn_browsing_data.h",
    "nn_cookies.cc",
    "nn_cookies.h",
    "nn_downloads.cc",
    "nn_downloads.h",
    "nn_downloads_mac.mm",
    "nn_engine.cc",
    "nn_engine.h",
    "nn_extensions.cc",
    "nn_extensions.h",
    "nn_external_apps.h",
    "nn_external_apps.mm",
    "nn_favicons.cc",
    "nn_history.cc",
    "nn_passwords.cc",
    "nn_passwords.h",
    "nn_prefs.cc",
    "nn_prefs.h",
    "nn_process.cc",
    "nn_process.h",
    "nn_reauth.cc",
    "nn_reauth.h",
    "nn_search_engines.cc",
    "nn_search_engines.h",
    "nn_sensitive_args.cc",
    "nn_sensitive_args.h",
    "nn_site_settings.cc",
    "nn_site_settings.h",
    "nn_tab_restore.cc",
    "nn_tabs.cc",
    "nn_tabs.h",
    "nn_zoom.cc",
    "nn_zoom.h",
    "pip/nn_pip_controls.cc",
    "pip/nn_pip_controls.h",
    "pip/nn_pip_mac.h",
    "pip/nn_pip_mac.mm",
    "pip/nn_pip_window.cc",
    "pip/nn_pip_window.h",
    "public/nn_engine.h",
  ]

  deps = [
    "//base",
    "//cc/paint",
    "//chrome/app:generated_resources",
    "//chrome/browser",
    "//chrome/browser/autofill",
    "//chrome/browser/browsing_data:constants",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/device_reauth",
    "//chrome/browser/download",
    "//chrome/browser/extensions",
    "//chrome/browser/extensions/api/passwords_private",
    "//chrome/browser/picture_in_picture",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search_engines",
    "//chrome/browser/task_manager",
    "//chrome/browser/ui",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/views/overlay",
    "//chrome/common",
    "//chrome/common/extensions/api",
    "//components/autofill/core/browser",
    "//components/autofill/core/common",
    "//components/bookmarks/browser",
    "//components/bookmarks/common",
    "//components/browsing_data/core",
    "//components/component_updater",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/device_reauth",
    "//components/download/content/public",
    "//components/download/public/common:public",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/history/core/browser",
    "//components/keyed_service/core",
    "//components/password_manager/core/browser",
    "//components/password_manager/core/common",
    "//components/prefs",
    "//components/search_engines",
    "//components/sessions",
    "//components/strings",
    "//components/update_client",
    "//components/tab_groups",
    "//components/tabs:public",
    "//content/public/browser",
    "//extensions/browser",
    "//extensions/common",
    "//net",
    "//services/media_session/public/cpp",
    "//services/network/public/mojom",
    "//skia",
    "//third_party/blink/public/common",
    "//third_party/boringssl",
    "//ui/base",
    "//ui/gfx",
    "//ui/views",
    "//url",
  ]

  # pip/: the Picture in Picture window's Core Animation fade.
  frameworks = [ "QuartzCore.framework" ]

  # nn_downloads_mac.mm: the quarantine record (LSQuarantine);
  # nn_external_apps.mm: the app that opens a scheme, and its icon.
  frameworks += [
    "AppKit.framework",
    "CoreServices.framework",
  ]
}

# Chrome's framework exports only what its lists name; NNCore's framework also
# exports every nn_* call. CEF's framework exports default-visibility symbols
# already, and an exports list there would hide CEF's own API, so only
# //chrome:chrome_dll depends on this.
config("exports_config") {
  ldflags = [ "-Wl,-exported_symbols_list," +
              rebase_path("nn_engine.exports", root_build_dir) ]
}

group("exports") {
  all_dependent_configs = [ ":exports_config" ]
  public_deps = [ ":netnyahoo" ]
}
