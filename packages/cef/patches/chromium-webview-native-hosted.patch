+
+#include "ui/views/controls/webview/native_hosted_contents.h"
+
+#include "content/public/browser/web_contents.h"
+
+namespace views {
+
+NativeHostedContents::NativeHostedContents(content::WebContents* web_contents)
+    : content::WebContentsUserData<NativeHostedContents>(*web_contents) {}
+
+NativeHostedContents::~NativeHostedContents() = default;
+
+// static
+void NativeHostedContents::Mark(content::WebContents* web_contents) {
+  CreateForWebContents(web_contents);
+}
+
+// static
+bool NativeHostedContents::IsMarked(const content::WebContents* web_contents) {
+  return web_contents && FromWebContents(web_contents);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(NativeHostedContents);
+
+}  // namespace views
diff -ruN a/ui/views/controls/webview/native_hosted_contents.h b/ui/views/controls/webview/native_hosted_contents.h
