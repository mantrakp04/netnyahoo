+CefString CefRequestContextImpl::LoadComponentExtension(
+    const CefString& root_directory) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return CefString();
+  }
+  if (!VerifyBrowserContext() || root_directory.empty()) {
+    return CefString();
+  }
+  auto* loader = extensions::ComponentLoader::Get(
+      browser_context()->AsBrowserContext());
+  if (!loader) {
+    return CefString();
+  }
+  return loader->AddOrReplace(base::FilePath(root_directory.ToString()));
+}
+
+void CefRequestContextImpl::UnloadComponentExtension(
+    const CefString& extension_id) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return;
+  }
+  if (!VerifyBrowserContext()) {
+    return;
+  }
+  if (auto* loader = extensions::ComponentLoader::Get(
+          browser_context()->AsBrowserContext())) {
+    loader->Remove(extensions::ExtensionId(extension_id.ToString()));
+  }
+}
