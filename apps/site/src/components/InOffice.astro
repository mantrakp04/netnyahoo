---
import Shot from "./Shot.astro";
import office from "../assets/shots/office.webp";
---

<section class="office" aria-label="The app" data-shot="office">
  <div class="wrap">
    <figure class="office-figure">
      <div class="tilt">
        <Shot
          src={office}
          alt="The Netnyahoo window in light mode: three pinned tiles and six tabs in the sidebar, Wikipedia’s article on Chromium open on the right."
          sizes="(max-width: 1440px) 94vw, 1360px"
          focus={{ x: 0, y: 0, zoom: 1.9, ratio: 0.8 }}
        />
      </div>
      <figcaption class="label">
        <span>Fig. 2 — In office</span>
        <span>A screenshot, not a mockup.</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .office {
    padding-top: clamp(24px, 4vw, 64px);
  }
  .office-figure {
    margin: 0;
    perspective: 1600px;
  }
  .tilt {
    transform-origin: 50% 0%;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tilt {
        animation: settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }
  @keyframes settle {
    from {
      transform: rotateX(14deg) scale(0.9) translateY(40px);
      opacity: 0.4;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 8px 24px;
    flex-wrap: wrap;
    margin-top: 22px;
    padding-top: 10px;
    border-top: 1px solid var(--rule-strong);
    color: var(--ink-2);
  }
</style>
