+// Netnyahoo: "Where's Big Yahu?" takes the dino's place. Wherever Chrome would
+// start the dino (an offline error in a main frame, the easter egg allowed),
+// the page is IDR_NETNYAHOO_YAHU_HTML instead, one self-contained document
+// whose JSON block receives the failed load.
+constexpr char kYahuErrorBlock[] =
+    "<script type=\"application/json\" id=\"yahu-error\">null</script>";
+constexpr char kYahuErrorPrefix[] =
+    "<script type=\"application/json\" id=\"yahu-error\">";
+
+bool ShowsYahu(RenderFrame* render_frame,
+               const LocalizedError::PageState& page_state) {
+  return render_frame->IsMainFrame() && page_state.is_offline_error &&
+         !page_state.strings.Find("disabledEasterEgg");
+}
+
+// Empty if the resource lacks its JSON block (Chrome's page is shown then).
+std::string YahuHtml(const error_page::Error& error) {
+  std::string html =
+      ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(
+          IDR_NETNYAHOO_YAHU_HTML);
+  const size_t block = html.find(kYahuErrorBlock);
+  if (block == std::string::npos) {
+    return std::string();
+  }
+  const GURL& url = error.url();
+  // chrome://dino and chrome://yahu play the game on its own.
+  const bool standalone = url.SchemeIs(content::kChromeUIScheme) &&
+                          (url.GetHost() == content::kChromeUIDinoHost ||
+                           url.GetHost() == content::kChromeUIYahuHost);
+  std::string json = "null";
+  if (!standalone) {
+    base::DictValue info;
+    info.Set("code", error.domain() == error_page::Error::kDnsProbeErrorDomain
+                         ? std::string(DnsProbeStatusToString(error.reason()))
+                         : net::ErrorToShortString(error.reason()));
+    info.Set("url", url.possibly_invalid_spec());
+    json = base::WriteJson(info).value_or("null");
+    // Nothing in it may close the <script> block.
+    base::ReplaceSubstringsAfterOffset(&json, 0, "<", "\\u003C");
+  }
+  html.replace(block + std::size(kYahuErrorPrefix) - 1, std::size("null") - 1,
+               json);
+  return html;
+}
+
 }  // namespace
 
