+class DeviceChooserImpl : public CefDeviceChooser,
+                          public permissions::ChooserController::View {
+ public:
+  explicit DeviceChooserImpl(
+      std::unique_ptr<permissions::ChooserController> controller)
+      : controller_(std::move(controller)) {
+    static int last_id = 0;
+    id_ = ++last_id;
+    controller_->set_view(this);
+  }
+  DeviceChooserImpl(const DeviceChooserImpl&) = delete;
+  DeviceChooserImpl& operator=(const DeviceChooserImpl&) = delete;
+
+  ~DeviceChooserImpl() override {
+    if (controller_) {
+      controller_->set_view(nullptr);
+    }
+  }
+
+  static std::map<int, CefRefPtr<DeviceChooserImpl>>& Live() {
+    static base::NoDestructor<std::map<int, CefRefPtr<DeviceChooserImpl>>>
+        live;
+    return *live;
+  }
+
+  // The client declined: Chrome's bubble gets the controller back.
+  std::unique_ptr<permissions::ChooserController> TakeController() {
+    open_ = false;
+    Live().erase(id_);
+    controller_->set_view(nullptr);
+    return std::move(controller_);
+  }
+
+  void Announced() { announced_ = true; }
+
+  // The owner (the page's request) closed the chooser.
+  void CloseFromChrome() {
+    if (!open_) {
+      return;
+    }
+    Finish(/*notify=*/true);
+  }
+
+  // CefDeviceChooser:
+  int GetIdentifier() override { return id_; }
+  bool IsOpen() override { return open_; }
+
+  CefRefPtr<CefDictionaryValue> GetState() override {
+    auto state = CefDictionaryValue::Create();
+    state->SetBool("open", open_);
+    auto options = CefListValue::Create();
+    if (open_ && controller_ && CEF_CURRENTLY_ON_UIT()) {
+      auto* c = controller_.get();
+      state->SetString("title", c->GetTitle());
+      state->SetString("okLabel", c->GetOkButtonLabel());
+      state->SetString("cancelLabel", c->GetCancelButtonLabel());
+      state->SetString("noOptionsText", c->GetNoOptionsText());
+      state->SetString("scanningText", c->GetThrobberLabelAndTooltip().first);
+      state->SetBool("refreshing", refreshing_);
+      state->SetBool("canRefresh", c->ShouldShowReScanButton());
+      state->SetBool("adapterOff", c->ShouldShowAdapterOffView() && !adapter_on_);
+      state->SetBool("unauthorized",
+                     c->ShouldShowAdapterUnauthorizedView() && !authorized_);
+      state->SetBool("bothButtonsEnabled", c->BothButtonsAlwaysEnabled());
+      state->SetBool("showSignal", c->ShouldShowIconBeforeText());
+      for (size_t i = 0; i < c->NumOptions(); ++i) {
+        auto option = CefDictionaryValue::Create();
+        option->SetString("name", c->GetOption(i));
+        option->SetBool("connected", c->IsConnected(i));
+        option->SetBool("paired", c->IsPaired(i));
+        option->SetInt("signal", c->ShouldShowIconBeforeText()
+                                     ? c->GetSignalStrengthLevel(i)
+                                     : -1);
+        options->SetDictionary(options->GetSize(), option);
+      }
+    }
+    state->SetList("options", options);
+    return state;
+  }
+
+  void Select(int index) override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(CEF_UIT,
+                    base::BindOnce(&DeviceChooserImpl::Select, this, index));
+      return;
+    }
+    if (!open_ || !controller_) {
+      return;
+    }
+    // A scanning prompt has no options to pick: OK allows it.
+    std::vector<size_t> indices;
+    if (index >= 0 && static_cast<size_t>(index) < controller_->NumOptions()) {
+      indices.push_back(static_cast<size_t>(index));
+    } else if (!controller_->BothButtonsAlwaysEnabled()) {
+      return;
+    }
+    CefRefPtr<DeviceChooserImpl> self(this);
+    Finish(/*notify=*/false);
+    controller_->Select(indices);
+    ReleaseController();
+  }
+
+  void Cancel() override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&DeviceChooserImpl::Cancel, this));
+      return;
+    }
+    if (!open_ || !controller_) {
+      return;
+    }
+    CefRefPtr<DeviceChooserImpl> self(this);
+    Finish(/*notify=*/false);
+    controller_->Cancel();
+    ReleaseController();
+  }
+
+  void Refresh() override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&DeviceChooserImpl::Refresh, this));
+      return;
+    }
+    if (open_ && controller_) {
+      controller_->RefreshOptions();
+    }
+  }
+
+  void OpenPermissionSettings() override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(
+          CEF_UIT,
+          base::BindOnce(&DeviceChooserImpl::OpenPermissionSettings, this));
+      return;
+    }
+    if (open_ && controller_) {
+      controller_->OpenPermissionPreferences();
+    }
+  }
+
+  // permissions::ChooserController::View:
+  void OnOptionsInitialized() override { Changed(); }
+  void OnOptionAdded(size_t index) override { Changed(); }
+  void OnOptionRemoved(size_t index) override { Changed(); }
+  void OnOptionUpdated(size_t index) override { Changed(); }
+  void OnAdapterEnabledChanged(bool enabled) override {
+    adapter_on_ = enabled;
+    Changed();
+  }
+  void OnAdapterAuthorizationChanged(bool authorized) override {
+    authorized_ = authorized;
+    Changed();
+  }
+  void OnRefreshStateChanged(bool refreshing) override {
+    refreshing_ = refreshing;
+    Changed();
+  }
+
+ private:
+  void Changed() {
+    if (open_ && announced_ && Handler()) {
+      Handler()->OnDeviceChooserChanged(this);
+    }
+  }
+
+  void Finish(bool notify) {
+    CefRefPtr<DeviceChooserImpl> self(this);
+    open_ = false;
+    Live().erase(id_);
+    if (notify && announced_ && Handler()) {
+      Handler()->OnDeviceChooserChanged(this);
+    }
+    if (notify) {
+      ReleaseController();
+    }
+  }
+
+  // The controller may still be calling us: let it go after this task.
+  void ReleaseController() {
+    if (!controller_) {
+      return;
+    }
+    controller_->set_view(nullptr);
+    CEF_POST_TASK(
+        CEF_UIT,
+        base::BindOnce(
+            [](std::unique_ptr<permissions::ChooserController> controller) {},
+            std::move(controller_)));
+  }
+
+  std::unique_ptr<permissions::ChooserController> controller_;
+  int id_;
+  bool open_ = true;
+  bool announced_ = false;
+  bool refreshing_ = false;
+  bool adapter_on_ = true;
+  bool authorized_ = true;
+
+  IMPLEMENT_REFCOUNTING(DeviceChooserImpl);
+};
