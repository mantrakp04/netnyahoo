--- a/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc
+++ b/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc
@@ -1532,8 +1532,18 @@
 
   return false;
 }
+
+// Arcadia: ArcadiaCore (engine/arcadiacore) shows its own password prompt for the tabs
+// it hosts.
+bool (*g_arcadia_password_bubble)(content::WebContents* web_contents) =
+    nullptr;
 
 void ManagePasswordsUIController::ShowBubble() {
+  // Arcadia: ArcadiaCore may show its own password UI instead.
+  if (g_arcadia_password_bubble &&
+      g_arcadia_password_bubble(web_contents())) {
+    return;
+  }
   if (TabDialogs* tab_dialogs = TabDialogs::FromWebContents(web_contents())) {
     tab_dialogs->ShowManagePasswordsBubble(user_action_);
   }
