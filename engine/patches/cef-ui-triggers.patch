+
+#ifndef CEF_LIBCEF_BROWSER_CHROME_AUTOFILL_TRIGGER_H_
+#define CEF_LIBCEF_BROWSER_CHROME_AUTOFILL_TRIGGER_H_
+#pragma once
+
+namespace content {
+class WebContents;
+}
+
+namespace cef {
+
+// Starts following which form field has focus in |web_contents|, for
+// CefShowAutofillSuggestions (include/cef_chrome_ui.h). Does nothing until
+// Chrome's autofill client exists (its tab helpers are attached) or when it
+// already follows the tab. Defined in autofill_trigger.cc.
+void TrackAutofillFocus(content::WebContents* web_contents);
+
