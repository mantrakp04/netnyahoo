<!-- ClickHouse for Arcadia's telemetry (hexclave.deploy.ts). Data on the service's volume, logs on the
     console (Hexclave collects them), caches and system logs sized for a small single server. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>

    <path>/data/ch/</path>
    <tmp_path>/data/ch/tmp/</tmp_path>
    <user_files_path>/data/ch/user_files/</user_files_path>
    <format_schema_path>/data/ch/format_schemas/</format_schema_path>
    <user_directories>
        <local_directory>
            <path>/data/ch/access/</path>
        </local_directory>
    </user_directories>

    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>

    <!-- System logs are for debugging; a week is plenty and keeps them from growing into the disk. -->
    <query_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></query_log>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></part_log>
    <trace_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></trace_log>
    <text_log remove="1"/>
    <metric_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></metric_log>
    <asynchronous_metric_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></asynchronous_metric_log>
    <error_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></error_log>
    <latency_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
</clickhouse>
