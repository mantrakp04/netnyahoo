+CefRefPtr<CefDictionaryValue> CefGetExtensionActionState(
+    CefRefPtr<CefBrowser> browser,
+    const CefString& extension_id) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return nullptr;
+  }
+  auto* contents = ContentsOf(browser);
+  const auto* extension = EnabledExtension(contents, extension_id);
+  auto* action = extension ? extensions::ExtensionActionManager::Get(
+                                 contents->GetBrowserContext())
+                                 ->GetExtensionAction(*extension)
+                           : nullptr;
+  if (!action) {
+    return nullptr;
+  }
+  const int tab_id = TabIdOf(contents);
+  auto state = CefDictionaryValue::Create();
+  state->SetString("title", action->GetTitle(tab_id));
+  state->SetString("badgeText", action->GetDisplayBadgeText(tab_id));
+  state->SetInt("badgeColor",
+                static_cast<int>(action->GetBadgeBackgroundColor(tab_id)));
+  state->SetInt("badgeTextColor",
+                static_cast<int>(action->GetBadgeTextColor(tab_id)));
+  state->SetString("popup", action->GetPopupUrl(tab_id).spec());
+  state->SetBool("enabled", action->GetIsVisible(tab_id));
+  gfx::Image icon = action->GetExplicitlySetIcon(tab_id);
+  if (icon.IsEmpty()) {
+    icon = action->GetDeclarativeIcon(tab_id);
+  }
+  state->SetString("icon", PngDataUrl(icon));
+  return state;
+}
+
+CefString CefGetExtensionSidePanel(CefRefPtr<CefBrowser> browser,
+                                   const CefString& extension_id) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return CefString();
+  }
+  auto* contents = ContentsOf(browser);
+  const auto* extension = EnabledExtension(contents, extension_id);
+  auto* service = extension ? extensions::SidePanelService::Get(
+                                  contents->GetBrowserContext())
+                            : nullptr;
+  if (!service) {
+    return CefString();
+  }
+  auto options = service->GetOptions(*extension, TabIdOf(contents));
+  if (!options.path || !options.enabled.value_or(false)) {
+    return CefString();
+  }
+  return extension->GetResourceURL(*options.path).spec();
+}
+
+bool CefShowCastDialog(CefRefPtr<CefBrowser> browser) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+  auto* contents = ContentsOf(browser);
+  if (!contents ||
+      !media_router::MediaRouterEnabled(contents->GetBrowserContext())) {
+    return false;
+  }
+  media_router::MediaRouterDialogController::GetOrCreateForWebContents(contents)
+      ->ShowMediaRouterDialog(
+          media_router::MediaRouterDialogActivationLocation::TOOLBAR);
+  return true;
+}
