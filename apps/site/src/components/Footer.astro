---
import { RELEASES, REPO } from "../data/release";
---

<footer class="foot" data-shot="footer">
  <div class="wrap">
    <p class="poster paid" aria-label="Paid for by nobody.">Paid for by nobody.</p>
    <div class="cols">
      <nav class="col" aria-label="Project">
        <p class="label h">Project</p>
        <a class="link" href={REPO} rel="noopener">Source on GitHub</a>
        <a class="link" href={RELEASES} rel="noopener">Releases</a>
        <a class="link" href={`${REPO}/issues`} rel="noopener">Report a bug</a>
      </nav>
      <div class="col">
        <p class="label h">Disclaimer</p>
        <p>
          Netnyahoo is political satire. Big Yahu caricatures Benjamin Netanyahu, a head of government, and his
          politics. Not affiliated with Google, The Browser Company, or any government, lobby or donor.
        </p>
      </div>
      <div class="col">
        <p class="label h">Credits</p>
        <p>
          Built on Chromium, CEF and the ungoogled-chromium patches. Ad blocking by uBlock Origin Lite. Set in Archivo,
          Newsreader and Martian Mono, served from here: this page loads nothing from Google.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--night);
    color: var(--night-ink);
    padding: clamp(64px, 9vw, 128px) 0 clamp(40px, 5vw, 64px);
    margin-top: clamp(64px, 8vw, 120px);
  }
  .paid {
    font-size: clamp(3rem, 0.6rem + 10.4vw, 11.4rem);
    line-height: 0.84;
    margin-left: -0.04em;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 36px;
    margin-top: clamp(48px, 6vw, 88px);
    padding-top: 24px;
    border-top: 1px solid var(--night-rule);
    font-size: var(--t-small);
    color: var(--night-ink-2);
  }
  .col {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .col p:not(.h) {
    max-width: 30em;
  }
  .h {
    color: var(--night-ink);
    margin-bottom: 6px;
  }
  .col a {
    color: var(--night-ink);
  }
  @media (max-width: 800px) {
    .col {
      grid-column: 1 / -1;
    }
  }
</style>
