+// Netnyahoo: Dia's progress bar, a 5 pt white capsule over a track of white at
+// 27 %, 12 pt from the sides and 9 pt from the bottom. Click or drag to seek.
+class NetnyahooProgressBar : public views::View {
+  METADATA_HEADER(NetnyahooProgressBar, views::View)
+
+ public:
+  // Hit slop around the bar, on every side.
+  static constexpr int kSlopX = 4;
+  static constexpr int kSlopY = 6;
+  static constexpr float kBarHeight = 5;
+
+  explicit NetnyahooProgressBar(base::RepeatingCallback<void(double)> seek)
+      : seek_(std::move(seek)) {}
+  NetnyahooProgressBar(const NetnyahooProgressBar&) = delete;
+  NetnyahooProgressBar& operator=(const NetnyahooProgressBar&) = delete;
+  ~NetnyahooProgressBar() override = default;
+
+  void SetMediaPosition(const media_session::MediaPosition& position) {
+    position_ = position;
+    if (!dragging_) {
+      drag_fraction_.reset();
+    }
+    SchedulePaint();
+    if (position_.playback_rate() == 0 || position_.duration().is_zero()) {
+      timer_.Stop();
+    } else if (!timer_.IsRunning()) {
+      timer_.Start(FROM_HERE, base::Milliseconds(100),
+                   base::BindRepeating(
+                       [](NetnyahooProgressBar* bar) {
+                         if (bar->IsDrawn()) {
+                           bar->SchedulePaint();
+                         }
+                       },
+                       base::Unretained(this)));
+    }
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    const base::TimeDelta duration = position_.duration();
+    if (!duration.is_positive() || duration.is_max()) {
+      return;
+    }
+    const gfx::RectF track(kSlopX, kSlopY, width() - 2 * kSlopX, kBarHeight);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SkColorSetA(SK_ColorWHITE, 0x44));
+    canvas->DrawRoundRect(track, kBarHeight / 2, flags);
+    const double fraction = std::clamp(
+        drag_fraction_.value_or(position_.GetPosition() / duration), 0.0, 1.0);
+    if (fraction <= 0) {
+      return;
+    }
+    gfx::RectF played = track;
+    played.set_width(
+        std::max(kBarHeight, static_cast<float>(track.width() * fraction)));
+    flags.setColor(SK_ColorWHITE);
+    canvas->DrawRoundRect(played, kBarHeight / 2, flags);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    dragging_ = true;
+    drag_fraction_ = FractionAt(event.x());
+    SchedulePaint();
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    drag_fraction_ = FractionAt(event.x());
+    SchedulePaint();
+    return true;
+  }
+
+  // The bar holds the released position until the page reports the seek.
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    dragging_ = false;
+    if (drag_fraction_) {
+      seek_.Run(*drag_fraction_);
+    }
+  }
+
+  void OnMouseCaptureLost() override {
+    dragging_ = false;
+    drag_fraction_.reset();
+    SchedulePaint();
+  }
+
+  ui::Cursor GetCursor(const ui::MouseEvent& event) override {
+    return ui::mojom::CursorType::kHand;
+  }
+
+ private:
+  double FractionAt(int x) const {
+    return std::clamp((x - kSlopX) / std::max(1.0, width() - 2.0 * kSlopX),
+                      0.0, 1.0);
+  }
+
+  base::RepeatingCallback<void(double)> seek_;
+  media_session::MediaPosition position_;
+  std::optional<double> drag_fraction_;
+  bool dragging_ = false;
+  base::RepeatingTimer timer_;
+};
