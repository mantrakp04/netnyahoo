@@ -0,0 +1,41 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_VIEWS_CONTROLS_WEBVIEW_NATIVE_HOSTED_CONTENTS_H_
+#define UI_VIEWS_CONTROLS_WEBVIEW_NATIVE_HOSTED_CONTENTS_H_
+
+#include "content/public/browser/web_contents_user_data.h"
+#include "ui/views/controls/webview/webview_export.h"
+
+namespace views {
+
+// Marks a WebContents whose native view the embedder hosts itself, outside the
+// Views hierarchy. A WebView showing it never attaches that native view to its
+// NativeViewHost. On macOS attaching would permanently switch the tab's
+// RenderWidgetHostViewMac to drawing through the Views compositor
+// (RenderWidgetHostViewMac::SetParentUiLayer), leaving the embedder's copy of
+// the NSView blank; unattached, it keeps its own compositor and draws into its
+// own NSView wherever the embedder puts it.
+class WEBVIEW_EXPORT NativeHostedContents
+    : public content::WebContentsUserData<NativeHostedContents> {
+ public:
+  NativeHostedContents(const NativeHostedContents&) = delete;
+  NativeHostedContents& operator=(const NativeHostedContents&) = delete;
+  ~NativeHostedContents() override;
+
+  // Marks |web_contents|. Call before it is shown in a WebView; a WebView that
+  // already attached it detaches it the next time it changes contents.
+  static void Mark(content::WebContents* web_contents);
+  static bool IsMarked(const content::WebContents* web_contents);
+
+ private:
+  friend class content::WebContentsUserData<NativeHostedContents>;
+  explicit NativeHostedContents(content::WebContents* web_contents);
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace views
+
+#endif  // UI_VIEWS_CONTROLS_WEBVIEW_NATIVE_HOSTED_CONTENTS_H_
