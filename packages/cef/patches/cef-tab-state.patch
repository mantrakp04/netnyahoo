+namespace {
 
+// GetNavigationState's format: version, selected index, entry count, then each
+// sessions::SerializedNavigationEntry as session restore pickles it.
+constexpr int kNavigationStateVersion = 1;
+// Per entry, like session restore's on-disk limit (the page state is dropped
+// from larger entries).
+constexpr int kMaxNavigationEntryBytes = 256 * 1024;
+
+bool ParseNavigationState(
+    const std::string& state,
+    std::vector<sessions::SerializedNavigationEntry>* navigations,
+    int* selected) {
+  std::optional<std::vector<uint8_t>> bytes = base::Base64Decode(state);
+  if (!bytes || bytes->empty()) {
+    return false;
+  }
+  base::Pickle pickle = base::Pickle::WithUnownedBuffer(*bytes);
+  base::PickleIterator it(pickle);
+  int version = 0, count = 0;
+  if (!it.ReadInt(&version) || version != kNavigationStateVersion ||
+      !it.ReadInt(selected) || !it.ReadInt(&count) || count <= 0) {
+    return false;
+  }
+  for (int i = 0; i < count; ++i) {
+    sessions::SerializedNavigationEntry entry;
+    if (!entry.ReadFromPickle(&it)) {
+      return false;
+    }
+    navigations->push_back(std::move(entry));
+  }
+  *selected = std::clamp(*selected, 0, count - 1);
+  return true;
+}
